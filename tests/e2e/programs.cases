//// case: mandelbrot_ascii
#include <stdio.h>
int main(void) {
    for (int y = -6; y <= 6; y++) {
        for (int x = -20; x <= 8; x++) {
            double cr = x / 10.0, ci = y / 6.0, zr = 0, zi = 0;
            int i;
            for (i = 0; i < 30 && zr * zr + zi * zi < 4; i++) { double t = zr * zr - zi * zi + cr; zi = 2 * zr * zi + ci; zr = t; }
            putchar(i == 30 ? '#' : i > 6 ? '+' : i > 2 ? '.' : ' ');
        }
        putchar('\n');
    }
    return 0;
}
