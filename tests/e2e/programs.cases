//// case: collatz_and_gcd_lcm
#include <stdio.h>
static int collatz(long n) { int steps = 0; while (n != 1) { n = n % 2 ? 3 * n + 1 : n / 2; steps++; } return steps; }
static long gcd(long a, long b) { while (b) { long t = a % b; a = b; b = t; } return a; }
int main(void) {
    int best = 0, arg = 0;
    for (int i = 1; i < 1000; i++) { int s = collatz(i); if (s > best) { best = s; arg = i; } }
    printf("%d %d\n", arg, best);
    printf("%ld %ld\n", gcd(1071, 462), 1071 / gcd(1071, 462) * 462);
    return 0;
}
