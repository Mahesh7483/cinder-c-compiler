//// case: expression_evaluator
#include <stdio.h>
#include <ctype.h>
static const char *s;
static long expr(void);
static long factor(void) {
    while (*s == ' ') s++;
    if (*s == '(') { s++; long v = expr(); while (*s == ' ') s++; s++; return v; }
    if (*s == '-') { s++; return -factor(); }
    long v = 0;
    while (isdigit((unsigned char)*s)) v = v * 10 + (*s++ - '0');
    return v;
}
static long term(void) {
    long v = factor();
    for (;;) {
        while (*s == ' ') s++;
        if (*s == '*') { s++; v *= factor(); }
        else if (*s == '/') { s++; v /= factor(); }
        else if (*s == '%') { s++; v %= factor(); }
        else return v;
    }
}
static long expr(void) {
    long v = term();
    for (;;) {
        while (*s == ' ') s++;
        if (*s == '+') { s++; v += term(); }
        else if (*s == '-') { s++; v -= term(); }
        else return v;
    }
}
int main(void) {
    const char *tests[] = {"1 + 2 * 3", "(1 + 2) * 3", "100 / 7 % 5", "-(4 - 10) * 2", "2 * (3 + (4 - 1)) * 5"};
    for (int i = 0; i < 5; i++) { s = tests[i]; printf("%s = %ld\n", tests[i], expr()); }
    return 0;
}
