//// case: crc32_table
#include <stdio.h>
#include <string.h>
static unsigned table[256];
static void init(void) {
    for (unsigned i = 0; i < 256; i++) {
        unsigned c = i;
        for (int k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320u ^ (c >> 1) : c >> 1;
        table[i] = c;
    }
}
static unsigned crc32(const unsigned char *p, size_t n) {
    unsigned c = 0xFFFFFFFFu;
    while (n--) c = table[(c ^ *p++) & 0xFF] ^ (c >> 8);
    return c ^ 0xFFFFFFFFu;
}
int main(void) {
    init();
    const char *msgs[] = {"", "a", "123456789", "The quick brown fox jumps over the lazy dog"};
    for (int i = 0; i < 4; i++) printf("%08x\n", crc32((const unsigned char *)msgs[i], strlen(msgs[i])));
    return 0;
}
