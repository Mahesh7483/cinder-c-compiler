//// case: string_processing
#include <stdio.h>
#include <string.h>
#include <ctype.h>
static void reverse(char *s) { for (int i = 0, j = (int)strlen(s) - 1; i < j; i++, j--) { char t = s[i]; s[i] = s[j]; s[j] = t; } }
static int is_palindrome(const char *s) {
    int i = 0, j = (int)strlen(s) - 1;
    while (i < j) {
        while (i < j && !isalnum((unsigned char)s[i])) i++;
        while (i < j && !isalnum((unsigned char)s[j])) j--;
        if (tolower((unsigned char)s[i++]) != tolower((unsigned char)s[j--])) return 0;
    }
    return 1;
}
static int count_words(const char *s) {
    int n = 0, in = 0;
    for (; *s; s++) { if (isspace((unsigned char)*s)) in = 0; else if (!in) { in = 1; n++; } }
    return n;
}
int main(void) {
    char a[] = "stressed desserts";
    reverse(a);
    printf("%s\n", a);
    printf("%d %d\n", is_palindrome("A man, a plan, a canal: Panama"), is_palindrome("not one"));
    printf("%d\n", count_words("  the quick  brown fox jumps "));
    return 0;
}
