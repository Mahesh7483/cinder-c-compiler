//// case: hanoi_and_pascal
#include <stdio.h>
static int moves;
static void hanoi(int n, char a, char b, char c) {
    if (n == 0) return;
    hanoi(n - 1, a, c, b);
    moves++;
    hanoi(n - 1, c, b, a);
}
int main(void) {
    hanoi(10, 'A', 'B', 'C');
    printf("%d\n", moves);
    int t[10][10] = {{0}};
    for (int i = 0; i < 10; i++) { t[i][0] = 1; for (int j = 1; j <= i; j++) t[i][j] = t[i - 1][j - 1] + (j < i ? t[i - 1][j] : 0); }
    for (int i = 0; i < 7; i++) { for (int j = 0; j <= i; j++) printf("%d ", t[i][j]); printf("\n"); }
    return 0;
}
