//// case: caesar_and_rle
#include <stdio.h>
#include <string.h>
static void caesar(char *s, int k) {
    for (; *s; s++) {
        if (*s >= 'a' && *s <= 'z') *s = 'a' + (*s - 'a' + k + 26) % 26;
        else if (*s >= 'A' && *s <= 'Z') *s = 'A' + (*s - 'A' + k + 26) % 26;
    }
}
static void rle(const char *s, char *out) {
    while (*s) {
        char c = *s; int n = 0;
        while (*s == c) { s++; n++; }
        out += sprintf(out, "%d%c", n, c);
    }
}
int main(void) {
    char m[] = "Hello, World!";
    caesar(m, 3); printf("%s\n", m);
    caesar(m, -3); printf("%s\n", m);
    char out[64];
    rle("aaabccddddde", out);
    printf("%s\n", out);
    return 0;
}
//// stdout
Khoor, Zruog!
Hello, World!
