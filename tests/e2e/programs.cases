//// case: values_live_across_calls
#include <stdio.h>
static int id(int x) { return x; }
static double idd(double x) { return x; }
int main(void) {
    int a = id(1), b = id(2), c = id(3), d = id(4), e = id(5), f = id(6), g = id(7), h = id(8);
    double x = idd(1.5), y = idd(2.5), z = idd(3.5);
    int s = a + b + c + d + e + f + g + h + id(100);
    double t = x + y + z + idd(10.0);
    printf("%d %.1f %d %d %d\n", s, t, a * h, b * g, c * f + d * e);
    return 0;
}
//// stdout
136 17.5 8 14 38
//// case: deep_recursion_ackermann
#include <stdio.h>
static int ack(int m, int n) { return m == 0 ? n + 1 : n == 0 ? ack(m - 1, 1) : ack(m - 1, ack(m, n - 1)); }
static long sum_to(long n) { return n == 0 ? 0 : n + sum_to(n - 1); }
int main(void) {
    printf("%d %d %d\n", ack(2, 3), ack(3, 3), ack(2, 0));
    printf("%ld\n", sum_to(10000));
    return 0;
}
//// stdout
9 61 3
50005000
//// case: roman_numerals
#include <stdio.h>
static void roman(int n, char *out) {
    static const int v[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    static const char *s[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    *out = 0;
    for (int i = 0; i < 13; i++) while (n >= v[i]) { for (const char *p = s[i]; *p; p++) *out++ = *p; *out = 0; n -= v[i]; }
}
int main(void) {
    int tests[] = {1, 4, 9, 14, 40, 90, 400, 1994, 2024, 3999};
    char buf[32];
    for (int i = 0; i < 10; i++) { roman(tests[i], buf); printf("%d=%s ", tests[i], buf); }
    printf("\n");
    return 0;
}
//// stdout
1=I 4=IV 9=IX 14=XIV 40=XL 90=XC 400=CD 1994=MCMXCIV 2024=MMXXIV 3999=MMMCMXCIX 
//// case: big_number_addition
#include <stdio.h>
#include <string.h>
int main(void) {
    const char *a = "99999999999999999999999999", *b = "1";
    int la = strlen(a), lb = strlen(b), n = la > lb ? la : lb;
    char r[64]; int carry = 0, k = 0;
    for (int i = 0; i < n; i++) {
        int da = i < la ? a[la - 1 - i] - '0' : 0, db = i < lb ? b[lb - 1 - i] - '0' : 0;
        int s = da + db + carry; r[k++] = '0' + s % 10; carry = s / 10;
    }
    if (carry) r[k++] = '1';
    while (k) putchar(r[--k]);
    putchar('\n');
    return 0;
}
//// stdout
100000000000000000000000000
//// case: vector_math_with_structs
#include <stdio.h>
#include <math.h>
typedef struct { double x, y, z; } vec3;
static vec3 add(vec3 a, vec3 b) { return (vec3){a.x + b.x, a.y + b.y, a.z + b.z}; }
static vec3 scale(vec3 a, double k) { return (vec3){a.x * k, a.y * k, a.z * k}; }
static double dot(vec3 a, vec3 b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
static vec3 cross(vec3 a, vec3 b) { return (vec3){a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x}; }
int main(void) {
    vec3 a = {1, 2, 3}, b = {4, 5, 6};
    vec3 c = cross(a, b);
    printf("%.1f %.1f %.1f %.1f\n", c.x, c.y, c.z, dot(a, b));
    vec3 d = add(scale(a, 2), b);
    printf("%.1f %.1f %.1f %.4f\n", d.x, d.y, d.z, sqrt(dot(d, d)));
    return 0;
}
//// stdout
-3.0 6.0 -3.0 32.0
6.0 9.0 12.0 16.1555
//// case: dynamic_array_and_strings
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
struct vec { int *data; int len, cap; };
static void push(struct vec *v, int x) {
    if (v->len == v->cap) { v->cap = v->cap ? v->cap * 2 : 2; v->data = realloc(v->data, v->cap * sizeof(int)); }
    v->data[v->len++] = x;
}
int main(void) {
    struct vec v = {0};
    for (int i = 0; i < 20; i++) push(&v, i * 3);
    long s = 0;
    for (int i = 0; i < v.len; i++) s += v.data[i];
    printf("%d %d %ld\n", v.len, v.cap, s);
    free(v.data);
    char **lines = malloc(3 * sizeof *lines);
    const char *src[] = {"alpha", "beta", "gamma"};
    for (int i = 0; i < 3; i++) lines[i] = strdup(src[i]);
    for (int i = 2; i >= 0; i--) printf("%s ", lines[i]);
    printf("\n");
    for (int i = 0; i < 3; i++) free(lines[i]);
    free(lines);
    return 0;
}
//// stdout
20 32 570
gamma beta alpha 
