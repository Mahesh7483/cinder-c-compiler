#include <stdio.h>
int main(void) {
    double a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8, i = 9, j = 10;
    double k = 11, l = 12, m = 13, n = 14, o = 15, p = 16, q = 17, r = 18, s = 19, t = 20;
    for (int it = 0; it < 4; it++) {
        a = a * 0.5 + b; b = b * 0.5 + c; c = c * 0.5 + d; d = d * 0.5 + e; e = e * 0.5 + f;
        f = f * 0.5 + g; g = g * 0.5 + h; h = h * 0.5 + i; i = i * 0.5 + j; j = j * 0.5 + k;
        k = k * 0.5 + l; l = l * 0.5 + m; m = m * 0.5 + n; n = n * 0.5 + o; o = o * 0.5 + p;
        p = p * 0.5 + q; q = q * 0.5 + r; r = r * 0.5 + s; s = s * 0.5 + t; t = t * 0.5 + a;
    }
    printf("%.3f %.3f %.3f %.3f %.3f\n", a, b, c, d, e);
    printf("%.3f %.3f %.3f %.3f %.3f\n", f, g, h, i, j);
    printf("%.3f %.3f %.3f %.3f %.3f\n", k, l, m, n, o);
    printf("%.3f %.3f %.3f %.3f %.3f\n", p, q, r, s, t);
    return 0;
}
