//// case: base_conversion_and_bits
#include <stdio.h>
static void to_base(unsigned n, int base, char *buf) {
    char tmp[40]; int i = 0;
    if (n == 0) tmp[i++] = '0';
    while (n) { int d = n % base; tmp[i++] = d < 10 ? '0' + d : 'a' + d - 10; n /= base; }
    int j = 0;
    while (i) buf[j++] = tmp[--i];
    buf[j] = 0;
}
static int popcount(unsigned long x) { int c = 0; while (x) { x &= x - 1; c++; } return c; }
int main(void) {
    char buf[40];
    unsigned vals[] = {0, 5, 255, 1000, 4294967295u};
    for (int i = 0; i < 5; i++) {
        to_base(vals[i], 2, buf); printf("%s ", buf);
        to_base(vals[i], 16, buf); printf("%s ", buf);
        to_base(vals[i], 36, buf); printf("%s\n", buf);
    }
    printf("%d %d %d\n", popcount(0), popcount(255), popcount(0xFFFFFFFFFFFFFFFFUL));
    return 0;
}
