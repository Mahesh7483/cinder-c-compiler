//// case: hash_table_chaining
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define BUCKETS 16
struct entry { char *key; int value; struct entry *next; };
static struct entry *table[BUCKETS];
static unsigned hash(const char *s) { unsigned h = 5381; while (*s) h = h * 33 + (unsigned char)*s++; return h; }
static void put(const char *k, int v) {
    unsigned b = hash(k) % BUCKETS;
    for (struct entry *e = table[b]; e; e = e->next) if (!strcmp(e->key, k)) { e->value = v; return; }
    struct entry *e = malloc(sizeof *e);
    e->key = strdup(k); e->value = v; e->next = table[b]; table[b] = e;
}
static int get(const char *k) {
    for (struct entry *e = table[hash(k) % BUCKETS]; e; e = e->next) if (!strcmp(e->key, k)) return e->value;
    return -1;
}
int main(void) {
    const char *words[] = {"apple", "banana", "cherry", "date", "elderberry", "fig", "grape"};
    for (int i = 0; i < 7; i++) put(words[i], i * i);
    put("cherry", 99);
    for (int i = 0; i < 7; i++) printf("%s=%d ", words[i], get(words[i]));
    printf("%d\n", get("missing"));
    return 0;
}
//// stdout
apple=0 banana=1 cherry=99 date=9 elderberry=16 fig=25 grape=36 -1
//// case: stack_machine
#include <stdio.h>
enum { PUSH, ADD, MUL, SUB, DUP, SWAP, PRINT, HALT };
int main(void) {
    int prog[] = {PUSH, 6, PUSH, 7, MUL, DUP, PRINT, PUSH, 2, SWAP, SUB, PRINT, HALT};
    int stack[32], sp = 0, pc = 0;
    for (;;) {
        switch (prog[pc++]) {
        case PUSH: stack[sp++] = prog[pc++]; break;
        case ADD: sp--; stack[sp - 1] += stack[sp]; break;
        case MUL: sp--; stack[sp - 1] *= stack[sp]; break;
        case SUB: sp--; stack[sp - 1] -= stack[sp]; break;
        case DUP: stack[sp] = stack[sp - 1]; sp++; break;
        case SWAP: { int t = stack[sp - 1]; stack[sp - 1] = stack[sp - 2]; stack[sp - 2] = t; break; }
        case PRINT: printf("%d\n", stack[sp - 1]); break;
        case HALT: return 0;
        }
    }
}
