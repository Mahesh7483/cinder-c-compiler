//// case: matrix_multiply
#include <stdio.h>
#define N 4
int main(void) {
    double a[N][N], b[N][N], c[N][N];
    for (int i = 0; i < N; i++) for (int j = 0; j < N; j++) { a[i][j] = i + j; b[i][j] = i == j ? 2.0 : 0.5; c[i][j] = 0; }
    for (int i = 0; i < N; i++)
        for (int j = 0; j < N; j++)
            for (int k = 0; k < N; k++) c[i][j] += a[i][k] * b[k][j];
    for (int i = 0; i < N; i++) { for (int j = 0; j < N; j++) printf("%6.2f ", c[i][j]); printf("\n"); }
    return 0;
}
