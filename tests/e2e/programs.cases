#include <stdio.h>
static unsigned long state = 12345;
static unsigned next(void) { state = state * 6364136223846793005UL + 1442695040888963407UL; return (unsigned)(state >> 33); }
static unsigned long mix(unsigned long x) {
    x ^= x >> 33; x *= 0xff51afd7ed558ccdUL; x ^= x >> 33; x *= 0xc4ceb9fe1a85ec53UL; x ^= x >> 33;
    return x;
}
int main(void) {
    for (int i = 0; i < 5; i++) printf("%u ", next() % 1000);
    printf("\n%lx %lx\n", mix(1), mix(0xdeadbeefUL));
