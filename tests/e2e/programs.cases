2 * (3 + (4 - 1)) * 5 = 60
//// case: game_of_life
#include <stdio.h>
#define W 8
#define H 6
static int g[H][W], n[H][W];
static int neighbors(int y, int x) {
    int c = 0;
    for (int dy = -1; dy <= 1; dy++) for (int dx = -1; dx <= 1; dx++) {
        if (!dy && !dx) continue;
        int yy = (y + dy + H) % H, xx = (x + dx + W) % W;
        c += g[yy][xx];
    }
    return c;
}
int main(void) {
    g[1][2] = g[2][3] = g[3][1] = g[3][2] = g[3][3] = 1;
    for (int gen = 0; gen < 4; gen++) {
        for (int y = 0; y < H; y++) for (int x = 0; x < W; x++) { int c = neighbors(y, x); n[y][x] = g[y][x] ? (c == 2 || c == 3) : c == 3; }
        for (int y = 0; y < H; y++) for (int x = 0; x < W; x++) g[y][x] = n[y][x];
    }
    for (int y = 0; y < H; y++) { for (int x = 0; x < W; x++) putchar(g[y][x] ? '#' : '.'); putchar('\n'); }
    return 0;
}
