//// case: many_live_integers_register_pressure
#include <stdio.h>
int main(void) {
    int a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8, i = 9, j = 10;
    int k = 11, l = 12, m = 13, n = 14, o = 15, p = 16, q = 17, r = 18, s = 19, t = 20;
    int u = 21, v = 22, w = 23, x = 24, y = 25, z = 26;
    for (int it = 0; it < 5; it++) {
        a += b * c; b += c * d; c += d * e; d += e * f; e += f * g; f += g * h; g += h * i; h += i * j;
        i += j * k; j += k * l; k += l * m; l += m * n; m += n * o; n += o * p; o += p * q; p += q * r;
        q += r * s; r += s * t; s += t * u; t += u * v; u += v * w; v += w * x; w += x * y; x += y * z;
        y += z * a; z += a * b;
        a %= 1000; b %= 1000; c %= 1000; d %= 1000; e %= 1000; f %= 1000; g %= 1000; h %= 1000; i %= 1000;
        j %= 1000; k %= 1000; l %= 1000; m %= 1000; n %= 1000; o %= 1000; p %= 1000; q %= 1000; r %= 1000;
        s %= 1000; t %= 1000; u %= 1000; v %= 1000; w %= 1000; x %= 1000; y %= 1000; z %= 1000;
    }
    printf("%d %d %d %d %d\n", a, b, c, d, e);
    printf("%d %d %d %d %d\n", f, g, h, i, j);
    printf("%d %d %d %d %d\n", k, l, m, n, o);
    printf("%d %d %d %d %d %d\n", p, q, r, s, t, u + v + w + x + y + z);
    return 0;
}
