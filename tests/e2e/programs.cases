//// case: sieve_of_eratosthenes
#include <stdio.h>
#define N 200
int main(void) {
    char composite[N + 1] = {0};
    int count = 0;
    for (int i = 2; i <= N; i++) {
        if (composite[i]) continue;
        count++;
        for (int j = i * i; j <= N; j += i) composite[j] = 1;
    }
    printf("%d primes up to %d\n", count, N);
    for (int i = 2; i < 60; i++) if (!composite[i]) printf("%d ", i);
    printf("\n");
    return 0;
}
