//// case: prog_bytecode_vm_with_switch_dispatch
#include <stdio.h>
enum { PUSH, ADD, SUB, MUL, DUP, SWAP, OVER, JNZ, JMP, LOAD, STORE, PRINT, HALT, LT, DEC, POP };
static long run(const int *code, int trace) {
    long stack[64], mem[16] = {0};
    int sp = 0, pc = 0;
    long steps = 0;
    for (;;) {
        steps++;
        switch (code[pc++]) {
        case PUSH: stack[sp++] = code[pc++]; break;
        case ADD: sp--; stack[sp - 1] += stack[sp]; break;
        case SUB: sp--; stack[sp - 1] -= stack[sp]; break;
        case MUL: sp--; stack[sp - 1] *= stack[sp]; break;
        case DUP: stack[sp] = stack[sp - 1]; sp++; break;
        case SWAP: { long t = stack[sp - 1]; stack[sp - 1] = stack[sp - 2]; stack[sp - 2] = t; break; }
        case OVER: stack[sp] = stack[sp - 2]; sp++; break;
        case JNZ: { int t = code[pc++]; if (stack[--sp]) pc = t; break; }
        case JMP: pc = code[pc]; break;
        case LOAD: stack[sp++] = mem[code[pc++]]; break;
        case STORE: mem[code[pc++]] = stack[--sp]; break;
        case PRINT: if (trace) printf("out %ld\n", stack[sp - 1]); sp--; break;
        case LT: sp--; stack[sp - 1] = stack[sp - 1] < stack[sp]; break;
        case DEC: stack[sp - 1]--; break;
        case POP: sp--; break;
        case HALT: return steps;
        default: return -1;
        }
    }
}
int main(void) {
    /* factorial of 10 in mem[1], counter in mem[0] */
    int fact[] = {PUSH, 10, STORE, 0, PUSH, 1, STORE, 1,
                  LOAD, 1, LOAD, 0, MUL, STORE, 1, LOAD, 0, DEC, DUP, STORE, 0, JNZ, 8,
                  LOAD, 1, PRINT, HALT};
    printf("steps=%ld\n", run(fact, 1));
    /* sum 1..100000 */
    int sum[] = {PUSH, 100000, STORE, 0, PUSH, 0, STORE, 1,
                 LOAD, 1, LOAD, 0, ADD, STORE, 1, LOAD, 0, DEC, DUP, STORE, 0, JNZ, 8,
                 LOAD, 1, PRINT, HALT};
    printf("steps=%ld\n", run(sum, 1));
    return 0;
}
