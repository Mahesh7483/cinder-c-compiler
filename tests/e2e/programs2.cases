//// case: prog_dijkstra_and_floyd_warshall
#include <stdio.h>
#define V 8
#define INF 1000000
static int g[V][V];
static int dist[V], prev_[V], done[V];
int main(void) {
    for (int i = 0; i < V; i++) for (int j = 0; j < V; j++) g[i][j] = i == j ? 0 : INF;
    int edges[][3] = {{0,1,4},{0,2,1},{2,1,2},{1,3,5},{2,3,8},{3,4,3},{4,5,1},{3,5,6},{5,6,2},{6,7,7},{4,7,12},{2,6,30}};
    for (int i = 0; i < (int)(sizeof edges / sizeof edges[0]); i++) { g[edges[i][0]][edges[i][1]] = edges[i][2]; g[edges[i][1]][edges[i][0]] = edges[i][2]; }
    for (int i = 0; i < V; i++) { dist[i] = INF; prev_[i] = -1; }
    dist[0] = 0;
    for (int it = 0; it < V; it++) {
        int u = -1;
        for (int i = 0; i < V; i++) if (!done[i] && (u < 0 || dist[i] < dist[u])) u = i;
        done[u] = 1;
        for (int v = 0; v < V; v++) if (g[u][v] < INF && dist[u] + g[u][v] < dist[v]) { dist[v] = dist[u] + g[u][v]; prev_[v] = u; }
    }
    for (int i = 0; i < V; i++) {
        printf("0->%d dist %2d path", i, dist[i]);
        int path[V], n = 0;
        for (int v = i; v >= 0; v = prev_[v]) path[n++] = v;
        while (n--) printf(" %d", path[n]);
        printf("\n");
    }
    int fw[V][V];
    for (int i = 0; i < V; i++) for (int j = 0; j < V; j++) fw[i][j] = g[i][j];
    for (int k = 0; k < V; k++) for (int i = 0; i < V; i++) for (int j = 0; j < V; j++) if (fw[i][k] + fw[k][j] < fw[i][j]) fw[i][j] = fw[i][k] + fw[k][j];
    long total = 0;
    for (int i = 0; i < V; i++) for (int j = 0; j < V; j++) total += fw[i][j];
    printf("%d %d %ld\n", fw[0][7], fw[7][1], total);
    return 0;
}
