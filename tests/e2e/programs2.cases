//// case: prog_matrix_determinant_and_inverse
#include <stdio.h>
#include <math.h>
#define N 4
static double det(double m[N][N], int n) {
    double a[N][N];
    for (int i = 0; i < n; i++) for (int j = 0; j < n; j++) a[i][j] = m[i][j];
    double d = 1;
    for (int c = 0; c < n; c++) {
        int p = c;
        for (int r = c + 1; r < n; r++) if (fabs(a[r][c]) > fabs(a[p][c])) p = r;
        if (fabs(a[p][c]) < 1e-12) return 0;
        if (p != c) { for (int j = 0; j < n; j++) { double t = a[c][j]; a[c][j] = a[p][j]; a[p][j] = t; } d = -d; }
        d *= a[c][c];
        for (int r = c + 1; r < n; r++) {
            double f = a[r][c] / a[c][c];
            for (int j = c; j < n; j++) a[r][j] -= f * a[c][j];
        }
    }
    return d;
}
static void matmul3(double a[3][3], double b[3][3], double out[3][3]) {
    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) { out[i][j] = 0; for (int k = 0; k < 3; k++) out[i][j] += a[i][k] * b[k][j]; }
}
static int inverse3(double a[3][3], double inv[3][3]) {
    double c[3][3];
    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) {
        int r0 = (i + 1) % 3, r1 = (i + 2) % 3, c0 = (j + 1) % 3, c1 = (j + 2) % 3;
        c[i][j] = a[r0][c0] * a[r1][c1] - a[r0][c1] * a[r1][c0];
    }
    double dt = a[0][0] * c[0][0] + a[0][1] * c[0][1] + a[0][2] * c[0][2];
    if (fabs(dt) < 1e-12) return 0;
    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) inv[i][j] = c[j][i] / dt;
    return 1;
}
int main(void) {
    double m[N][N] = {{2, -1, 0, 3}, {1, 4, -2, 0}, {0, 5, 3, -1}, {7, 0, 1, 2}};
    printf("%.6f\n", det(m, N));
    double h[N][N];
    for (int i = 0; i < N; i++) for (int j = 0; j < N; j++) h[i][j] = 1.0 / (i + j + 1);
    printf("%.9f\n", det(h, N));
    double a[3][3] = {{4, 7, 2}, {3, 6, 1}, {2, 5, 3}}, inv[3][3], prod[3][3];
    printf("%d\n", inverse3(a, inv));
    matmul3(a, inv, prod);
    for (int i = 0; i < 3; i++) { for (int j = 0; j < 3; j++) printf("%8.4f ", inv[i][j]); printf("| "); for (int j = 0; j < 3; j++) printf("%.3f ", fabs(prod[i][j]) < 1e-9 ? 0.0 : prod[i][j]); printf("\n"); }
    return 0;
}
