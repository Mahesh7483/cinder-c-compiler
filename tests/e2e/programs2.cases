//// case: prog_rle_and_lz_compression_round_trip
#include <stdio.h>
#include <string.h>
static int rle_encode(const unsigned char *in, int n, unsigned char *out) {
    int o = 0;
    for (int i = 0; i < n;) {
        int j = i;
        while (j < n && in[j] == in[i] && j - i < 255) j++;
        out[o++] = (unsigned char)(j - i); out[o++] = in[i];
        i = j;
    }
    return o;
}
static int rle_decode(const unsigned char *in, int n, unsigned char *out) {
    int o = 0;
    for (int i = 0; i + 1 < n; i += 2) for (int k = 0; k < in[i]; k++) out[o++] = in[i + 1];
    return o;
}
static int lz_encode(const unsigned char *in, int n, unsigned char *out) {
    int o = 0;
    for (int i = 0; i < n;) {
        int best = 0, bo = 0;
        for (int j = i > 255 ? i - 255 : 0; j < i; j++) {
            int l = 0;
            while (i + l < n && in[j + l] == in[i + l] && l < 255) l++;
            if (l > best) { best = l; bo = i - j; }
        }
        if (best >= 3) { out[o++] = 0; out[o++] = (unsigned char)bo; out[o++] = (unsigned char)best; i += best; }
        else { out[o++] = 1; out[o++] = in[i++]; }
    }
    return o;
}
static int lz_decode(const unsigned char *in, int n, unsigned char *out) {
    int o = 0;
    for (int i = 0; i < n;) {
        if (in[i] == 1) { out[o++] = in[i + 1]; i += 2; }
        else { int off = in[i + 1], len = in[i + 2]; for (int k = 0; k < len; k++) { out[o] = out[o - off]; o++; } i += 3; }
    }
    return o;
}
int main(void) {
    unsigned char data[600], enc[1300], dec[700];
    int n = 0;
    for (int i = 0; i < 40; i++) data[n++] = 'a';
    for (int i = 0; i < 30; i++) data[n++] = (unsigned char)"abcabcabd"[i % 9];
    for (int i = 0; i < 200; i++) data[n++] = (unsigned char)((i * i) % 7 + '0');
    for (int i = 0; i < 20; i++) data[n++] = 'z';
    int e = rle_encode(data, n, enc), d = rle_decode(enc, e, dec);
    printf("rle %d -> %d ok=%d\n", n, e, d == n && !memcmp(data, dec, n));
    e = lz_encode(data, n, enc); d = lz_decode(enc, e, dec);
    printf("lz  %d -> %d ok=%d\n", n, e, d == n && !memcmp(data, dec, n));
    return 0;
}
