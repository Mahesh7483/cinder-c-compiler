//// case: prog_bigint_factorial_and_fibonacci
#include <stdio.h>
#include <string.h>
#define MAXD 400
typedef struct { int d[MAXD]; int n; } big;
static void set(big *b, int v) { memset(b, 0, sizeof *b); b->n = 0; do { b->d[b->n++] = v % 10; v /= 10; } while (v); }
static void mul_small(big *b, int m) {
    int carry = 0;
    for (int i = 0; i < b->n; i++) { int t = b->d[i] * m + carry; b->d[i] = t % 10; carry = t / 10; }
    while (carry) { b->d[b->n++] = carry % 10; carry /= 10; }
}
static void add(big *r, const big *a, const big *b) {
    int carry = 0, n = a->n > b->n ? a->n : b->n;
    big t; memset(&t, 0, sizeof t);
    for (int i = 0; i < n; i++) { int s = (i < a->n ? a->d[i] : 0) + (i < b->n ? b->d[i] : 0) + carry; t.d[i] = s % 10; carry = s / 10; }
    t.n = n;
    if (carry) t.d[t.n++] = carry;
    *r = t;
}
static void print(const big *b) { for (int i = b->n - 1; i >= 0; i--) putchar('0' + b->d[i]); putchar('\n'); }
int main(void) {
    big f; set(&f, 1);
    for (int i = 2; i <= 100; i++) mul_small(&f, i);
    printf("100! has %d digits\n", f.n);
    print(&f);
    big a, b, c; set(&a, 0); set(&b, 1);
    for (int i = 0; i < 300; i++) { add(&c, &a, &b); a = b; b = c; }
    printf("fib(300) has %d digits\n", a.n);
    print(&a);
    int digit_sum = 0;
    for (int i = 0; i < f.n; i++) digit_sum += f.d[i];
    printf("digit sum of 100! = %d\n", digit_sum);
    return 0;
}
