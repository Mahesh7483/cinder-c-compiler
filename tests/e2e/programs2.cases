//// case: prog_sudoku_solver
#include <stdio.h>
static int g[9][9];
static long nodes;
static int ok(int r, int c, int v) {
    for (int i = 0; i < 9; i++) if (g[r][i] == v || g[i][c] == v) return 0;
    int br = r / 3 * 3, bc = c / 3 * 3;
    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) if (g[br + i][bc + j] == v) return 0;
    return 1;
}
static int solve(void) {
    for (int r = 0; r < 9; r++)
        for (int c = 0; c < 9; c++) {
            if (g[r][c]) continue;
            for (int v = 1; v <= 9; v++) {
                if (!ok(r, c, v)) continue;
                g[r][c] = v; nodes++;
                if (solve()) return 1;
                g[r][c] = 0;
            }
            return 0;
        }
    return 1;
}
int main(void) {
    const char *puzzle = "530070000600195000098000060800060003400803001700020006060000280000419005000080079";
    for (int i = 0; i < 81; i++) g[i / 9][i % 9] = puzzle[i] - '0';
    int solved = solve();
    printf("solved=%d nodes=%ld\n", solved, nodes);
    for (int r = 0; r < 9; r++) { for (int c = 0; c < 9; c++) printf("%d", g[r][c]); printf("\n"); }
    return 0;
}
