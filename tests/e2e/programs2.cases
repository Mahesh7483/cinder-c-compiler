//// case: prog_sieve_collatz_and_gcd_tables
#include <stdio.h>
#include <string.h>
static unsigned gcd(unsigned a, unsigned b) { while (b) { unsigned t = a % b; a = b; b = t; } return a; }
int main(void) {
    static char comp[1000001];
    int primes = 0, last = 0;
    for (int i = 2; i <= 1000000; i++) {
        if (comp[i]) continue;
        primes++; last = i;
        for (long j = (long)i * i; j <= 1000000; j += i) comp[j] = 1;
    }
    printf("%d primes, largest %d\n", primes, last);
    int best = 0, best_n = 0;
    for (int n = 1; n < 100000; n++) {
        long x = n; int steps = 0;
        while (x != 1) { x = x % 2 ? 3 * x + 1 : x / 2; steps++; }
        if (steps > best) { best = steps; best_n = n; }
    }
    printf("collatz %d %d\n", best_n, best);
    unsigned long sum = 0;
    for (unsigned a = 1; a <= 300; a++) for (unsigned b = 1; b <= 300; b++) sum += gcd(a, b) * (a ^ b);
    printf("%lu\n", sum);
    unsigned twin = 0;
    for (int i = 3; i + 2 <= 1000000; i += 2) twin += !comp[i] && !comp[i + 2];
    printf("%u twin pairs\n", twin);
    return 0;
}
