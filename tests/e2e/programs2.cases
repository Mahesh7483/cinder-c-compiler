//// case: prog_word_frequency_hash_table
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#define CAP 256
struct entry { char *word; int count; };
static struct entry table[CAP];
static unsigned hash(const char *s) { unsigned h = 5381; while (*s) h = h * 33 + (unsigned char)*s++; return h; }
static void add(const char *w) {
    unsigned i = hash(w) % CAP;
    while (table[i].word && strcmp(table[i].word, w)) i = (i + 1) % CAP;
    if (!table[i].word) table[i].word = strdup(w);
    table[i].count++;
}
static int cmp(const void *a, const void *b) {
    const struct entry *x = a, *y = b;
    if (y->count != x->count) return y->count - x->count;
    return strcmp(x->word, y->word);
}
int main(void) {
    const char *text = "the quick brown fox jumps over the lazy dog. The dog barks; the fox runs away! "
                       "A quick brown dog? No, a lazy fox. Over the hills and far away, the fox and the dog meet.";
    char word[32];
    int len = 0;
    for (const char *p = text;; p++) {
        if (isalpha((unsigned char)*p)) { if (len < 31) word[len++] = (char)tolower((unsigned char)*p); }
        else { if (len) { word[len] = 0; add(word); len = 0; } if (!*p) break; }
    }
    struct entry list[CAP];
    int n = 0, total = 0;
    for (int i = 0; i < CAP; i++) if (table[i].word) { list[n++] = table[i]; total += table[i].count; }
    qsort(list, n, sizeof list[0], cmp);
    printf("%d distinct, %d total\n", n, total);
    for (int i = 0; i < 8; i++) printf("%-6s %d\n", list[i].word, list[i].count);
    for (int i = 0; i < CAP; i++) free(table[i].word);
    return 0;
}
