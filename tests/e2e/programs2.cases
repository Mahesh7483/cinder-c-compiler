//// case: prog_game_of_life
#include <stdio.h>
#include <string.h>
#define W 12
#define H 8
static char cur[H][W], nxt[H][W];
static int neighbours(int r, int c) {
    int n = 0;
    for (int dr = -1; dr <= 1; dr++)
        for (int dc = -1; dc <= 1; dc++)
            if (dr || dc) n += cur[(r + dr + H) % H][(c + dc + W) % W];
    return n;
}
static void step(void) {
    for (int r = 0; r < H; r++)
        for (int c = 0; c < W; c++) {
            int n = neighbours(r, c);
            nxt[r][c] = cur[r][c] ? (n == 2 || n == 3) : (n == 3);
        }
    memcpy(cur, nxt, sizeof cur);
}
static void show(int gen) {
    int alive = 0;
    printf("gen %d\n", gen);
    for (int r = 0; r < H; r++) { for (int c = 0; c < W; c++) { putchar(cur[r][c] ? '#' : '.'); alive += cur[r][c]; } putchar('\n'); }
    printf("alive=%d\n", alive);
}
int main(void) {
    cur[0][1] = cur[1][2] = cur[2][0] = cur[2][1] = cur[2][2] = 1;
    cur[5][8] = cur[5][9] = cur[5][10] = 1;
    show(0);
    for (int g = 1; g <= 20; g++) { step(); if (g % 10 == 0 || g == 1) show(g); }
    return 0;
}
