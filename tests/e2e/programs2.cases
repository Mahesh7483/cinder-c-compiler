//// case: prog_permutations_romans_and_pascal
#include <stdio.h>
#include <string.h>
static void permute(char *s, int k, int n, int *count) {
    if (k == n) { if ((*count)++ < 8) printf("%s ", s); return; }
    for (int i = k; i < n; i++) {
        char t = s[k]; s[k] = s[i]; s[i] = t;
        permute(s, k + 1, n, count);
        t = s[k]; s[k] = s[i]; s[i] = t;
    }
}
static void roman(int v, char *out) {
    static const int val[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    static const char *sym[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    out[0] = 0;
    for (int i = 0; i < 13; i++) while (v >= val[i]) { strcat(out, sym[i]); v -= val[i]; }
}
static int is_palindrome(const char *s) { int n = (int)strlen(s); for (int i = 0; i < n / 2; i++) if (s[i] != s[n - 1 - i]) return 0; return 1; }
int main(void) {
    char s[] = "abcd";
    int count = 0;
    permute(s, 0, 4, &count);
    printf("| %d\n", count);
    char buf[32];
    int years[] = {1, 4, 9, 14, 40, 90, 400, 1994, 2024, 3999};
    for (int i = 0; i < 10; i++) { roman(years[i], buf); printf("%d=%s ", years[i], buf); }
    printf("\n");
    const char *w[] = {"racecar", "level", "hello", "a", "abba", "abcba", "abca"};
    for (int i = 0; i < 7; i++) printf("%s:%d ", w[i], is_palindrome(w[i]));
    printf("\n");
    long row[16] = {1};
    for (int r = 0; r < 12; r++) {
        for (int k = r; k > 0; k--) row[k] += row[k - 1];
        for (int k = 0; k <= r; k++) printf("%ld ", row[k]);
        printf("\n");
    }
    return 0;
}
