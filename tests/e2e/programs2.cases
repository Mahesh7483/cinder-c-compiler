//// case: prog_base64_crc32_and_hashes
#include <stdio.h>
#include <string.h>
#include <stdint.h>
static const char *B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
static int b64_encode(const unsigned char *in, int n, char *out) {
    int o = 0;
    for (int i = 0; i < n; i += 3) {
        unsigned v = in[i] << 16;
        if (i + 1 < n) v |= in[i + 1] << 8;
        if (i + 2 < n) v |= in[i + 2];
        out[o++] = B64[v >> 18 & 63];
        out[o++] = B64[v >> 12 & 63];
        out[o++] = i + 1 < n ? B64[v >> 6 & 63] : '=';
        out[o++] = i + 2 < n ? B64[v & 63] : '=';
    }
    out[o] = 0;
    return o;
}
static int b64_decode(const char *in, unsigned char *out) {
    int o = 0;
    unsigned acc = 0; int bits = 0;
    for (; *in && *in != '='; in++) {
        const char *p = strchr(B64, *in);
        acc = acc << 6 | (unsigned)(p - B64); bits += 6;
        if (bits >= 8) { bits -= 8; out[o++] = (unsigned char)(acc >> bits & 255); }
    }
    return o;
}
static uint32_t crc_table[256];
static void crc_init(void) {
    for (uint32_t i = 0; i < 256; i++) { uint32_t c = i; for (int k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320u ^ (c >> 1) : c >> 1; crc_table[i] = c; }
}
static uint32_t crc32(const unsigned char *d, int n) { uint32_t c = 0xFFFFFFFFu; for (int i = 0; i < n; i++) c = crc_table[(c ^ d[i]) & 255] ^ (c >> 8); return c ^ 0xFFFFFFFFu; }
static uint64_t fnv1a(const char *s) { uint64_t h = 14695981039346656037ull; while (*s) { h ^= (unsigned char)*s++; h *= 1099511628211ull; } return h; }
int main(void) {
    const char *msgs[] = {"", "f", "fo", "foo", "foob", "fooba", "foobar", "Many hands make light work."};
    crc_init();
    for (int i = 0; i < 8; i++) {
        char enc[100]; unsigned char dec[100];
        int n = b64_encode((const unsigned char *)msgs[i], (int)strlen(msgs[i]), enc);
        int m = b64_decode(enc, dec); dec[m] = 0;
        printf("%-28s %-40s %d %08x %016llx\n", msgs[i], enc, strcmp((char *)dec, msgs[i]) == 0 && n >= 0, crc32((const unsigned char *)msgs[i], (int)strlen(msgs[i])), (unsigned long long)fnv1a(msgs[i]));
    }
    return 0;
}
