//// case: prog_struct_inventory_sorting
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
struct item { char name[16]; int qty; double price; };
static struct item inv[] = {{"widget", 40, 2.5}, {"gadget", 7, 19.99}, {"doohickey", 0, 5.0}, {"gizmo", 12, 7.25}, {"thingamajig", 3, 120.0}, {"whatsit", 25, 0.99}};
#define N ((int)(sizeof inv / sizeof inv[0]))
static int by_name(const void *a, const void *b) { return strcmp(((const struct item *)a)->name, ((const struct item *)b)->name); }
static int by_value(const void *a, const void *b) {
    double x = ((const struct item *)a)->qty * ((const struct item *)a)->price, y = ((const struct item *)b)->qty * ((const struct item *)b)->price;
    return (x < y) - (x > y);
}
static void show(const char *title) {
    printf("-- %s\n", title);
    double total = 0;
    for (int i = 0; i < N; i++) { printf("%-12s %3d %8.2f %9.2f\n", inv[i].name, inv[i].qty, inv[i].price, inv[i].qty * inv[i].price); total += inv[i].qty * inv[i].price; }
    printf("total %.2f\n", total);
}
int main(void) {
    show("as stocked");
    qsort(inv, N, sizeof inv[0], by_name);
    show("by name");
    qsort(inv, N, sizeof inv[0], by_value);
    show("by value");
    struct item key = {"gizmo", 0, 0};
    qsort(inv, N, sizeof inv[0], by_name);
    struct item *f = bsearch(&key, inv, N, sizeof inv[0], by_name);
    printf("found %s qty %d\n", f ? f->name : "none", f ? f->qty : -1);
    return 0;
}
