[11 steps]
//// case: prog_recursive_descent_calculator
#include <stdio.h>
#include <ctype.h>
#include <stdlib.h>
static const char *p;
static long expr(void);
static void skip(void) { while (isspace((unsigned char)*p)) p++; }
static long primary(void) {
    skip();
    if (*p == '(') { p++; long v = expr(); skip(); if (*p == ')') p++; return v; }
    if (*p == '-') { p++; return -primary(); }
    if (*p == '+') { p++; return primary(); }
    char *end;
    long v = strtol(p, &end, 10);
    p = end;
    return v;
}
static long power(void) {
    long b = primary();
    skip();
    if (*p == '^') { p++; long e = power(); long r = 1; while (e-- > 0) r *= b; return r; }
    return b;
}
static long term(void) {
    long v = power();
    for (;;) {
        skip();
        if (*p == '*') { p++; v *= power(); }
        else if (*p == '/') { p++; long d = power(); v = d ? v / d : 0; }
        else if (*p == '%') { p++; long d = power(); v = d ? v % d : 0; }
        else return v;
    }
}
static long expr(void) {
    long v = term();
    for (;;) {
        skip();
        if (*p == '+') { p++; v += term(); }
        else if (*p == '-') { p++; v -= term(); }
        else return v;
    }
}
int main(void) {
    const char *tests[] = {"1 + 2 * 3", "(1 + 2) * 3", "2 ^ 3 ^ 2", "-(4 - 10) * 2", "100 / 7 % 5", "((((7))))", "2*(3+4)*(5-1)/7", " 12 +  30 - 2 * (3 + 4)", "10 - 2 - 3", "2 ^ 10 - 1"};
    for (int i = 0; i < 10; i++) { p = tests[i]; printf("%s = %ld\n", tests[i], expr()); }
    return 0;
}
