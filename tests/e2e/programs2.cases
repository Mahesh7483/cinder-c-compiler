//// case: prog_n_queens
#include <stdio.h>
static int n = 8, count;
static int cols[16], d1[32], d2[32], pos[16], first[16], have_first;
static void solve(int r) {
    if (r == n) {
        if (!have_first) { have_first = 1; for (int i = 0; i < n; i++) first[i] = pos[i]; }
        count++;
        return;
    }
    for (int c = 0; c < n; c++) {
        if (cols[c] || d1[r + c] || d2[r - c + n]) continue;
        cols[c] = d1[r + c] = d2[r - c + n] = 1;
        pos[r] = c;
        solve(r + 1);
        cols[c] = d1[r + c] = d2[r - c + n] = 0;
    }
}
int main(void) {
    for (n = 4; n <= 9; n++) { count = 0; have_first = 0; solve(0); printf("n=%d solutions=%d\n", n, count); }
    n = 8; count = 0; have_first = 0; solve(0);
    for (int r = 0; r < 8; r++) { for (int c = 0; c < 8; c++) putchar(first[r] == c ? 'Q' : '.'); putchar('\n'); }
    return 0;
}
