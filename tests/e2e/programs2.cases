//// case: prog_brainfuck_interpreter
#include <stdio.h>
#include <string.h>
static void run(const char *prog) {
    unsigned char tape[3000] = {0};
    int ptr = 0;
    int len = (int)strlen(prog);
    int jump[512];
    int stack[64], sp = 0;
    for (int i = 0; i < len; i++) {
        if (prog[i] == '[') stack[sp++] = i;
        else if (prog[i] == ']') { int j = stack[--sp]; jump[i] = j; jump[j] = i; }
    }
    long steps = 0;
    for (int pc = 0; pc < len; pc++, steps++) {
        switch (prog[pc]) {
        case '>': ptr++; break;
        case '<': ptr--; break;
        case '+': tape[ptr]++; break;
        case '-': tape[ptr]--; break;
        case '.': putchar(tape[ptr]); break;
        case '[': if (!tape[ptr]) pc = jump[pc]; break;
        case ']': if (tape[ptr]) pc = jump[pc]; break;
        }
    }
    printf("[%ld steps]\n", steps);
}
int main(void) {
    run("++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.");
    run("++++++++[>++++++++<-]>+.");
    run("+++++[>+++++++<-]>++.");
    run("++++++++++.");
    return 0;
}
