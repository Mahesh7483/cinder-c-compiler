//// case: prog_mandelbrot_ascii
#include <stdio.h>
int main(void) {
    const char *ramp = " .:-=+*#%@";
    long checksum = 0;
    for (int y = -11; y <= 11; y++) {
        for (int x = -39; x <= 20; x++) {
            double cr = x / 20.0, ci = y / 10.0, zr = 0, zi = 0;
            int i = 0;
            while (i < 60 && zr * zr + zi * zi <= 4.0) { double t = zr * zr - zi * zi + cr; zi = 2 * zr * zi + ci; zr = t; i++; }
            putchar(ramp[i * 9 / 60]);
            checksum += i;
        }
        putchar('\n');
    }
    printf("%ld\n", checksum);
    return 0;
}
