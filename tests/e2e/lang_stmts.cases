//// case: stmt_returns_and_early_exit_in_loops
#include <stdio.h>
static int first_negative(const int *a, int n) {
    for (int i = 0; i < n; i++) if (a[i] < 0) return i;
    return -1;
}
static int find2(int m[3][3], int v) {
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            if (m[i][j] == v) return i * 10 + j;
    return -1;
}
static void noreturn_value(int x) { if (x) return; printf("zero\n"); }
int main(void) {
    int a[] = {3, 5, -2, 7, -9};
    int m[3][3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
    printf("%d %d %d %d\n", first_negative(a, 5), first_negative(a, 2), find2(m, 6), find2(m, 10));
    noreturn_value(1);
    noreturn_value(0);
    return first_negative(a, 5) + 1;
}
//// exit: 3
//// stdout
2 -1 12 -1
zero
//// case: stmt_main_variants_and_exit_codes
#include <stdio.h>
#include <stdlib.h>
static void bye(void) { printf("atexit ran\n"); }
int main(int argc, char **argv) {
    atexit(bye);
    printf("%d %d\n", argc, argv[0] != 0);
    if (argc == 1) exit(7);
    return 0;
}
//// exit: 7
//// stdout
1 1
atexit ran
