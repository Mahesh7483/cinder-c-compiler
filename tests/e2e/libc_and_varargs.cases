//// case: sprintf_and_snprintf
#include <stdio.h>
int main(void) {
    char buf[64];
    int n = sprintf(buf, "%d-%s-%c-%x", 42, "abc", 'Z', 255);
    printf("%s %d\n", buf, n);
    n = snprintf(buf, 8, "%s", "truncate me please");
    printf("%s %d\n", buf, n);
    snprintf(buf, sizeof buf, "%5.2f|%-6d|%06d|%+d", 3.14159, 42, 42, 42);
    printf("%s\n", buf);
    return 0;
}
