//// case: function_pointers
#include <stdio.h>
static int add(int a, int b) { return a + b; }
static int sub(int a, int b) { return a - b; }
static int apply(int (*f)(int, int), int a, int b) { return f(a, b); }
typedef int (*binop)(int, int);
int main(void) {
    int (*fp)(int, int) = add;
    printf("%d %d\n", fp(3, 4), apply(sub, 10, 3));
    binop ops[2] = {add, sub};
    for (int i = 0; i < 2; i++) printf("%d ", ops[i](20, 5));
    printf("\n");
    fp = &sub;
    printf("%d %d\n", (*fp)(9, 1), apply(fp, 1, 9));
    return 0;
}
//// stdout
7 7
25 15 
8 -8
//// case: callbacks_and_qsort
#include <stdio.h>
#include <stdlib.h>
static int cmp_asc(const void *a, const void *b) { return *(const int *)a - *(const int *)b; }
static int cmp_desc(const void *a, const void *b) { return *(const int *)b - *(const int *)a; }
int main(void) {
    int v[] = {5, 2, 9, 1, 7, 3, 8, 3};
    int n = sizeof v / sizeof v[0];
    qsort(v, n, sizeof v[0], cmp_asc);
    for (int i = 0; i < n; i++) printf("%d ", v[i]);
    printf("\n");
    qsort(v, n, sizeof v[0], cmp_desc);
    for (int i = 0; i < n; i++) printf("%d ", v[i]);
    printf("\n");
    qsort(v, n, sizeof v[0], cmp_asc);
    int key = 7;
    int *hit = bsearch(&key, v, n, sizeof v[0], cmp_asc);
    printf("%d %ld\n", hit ? *hit : -1, hit ? (long)(hit - v) : -1L);
    return 0;
}
//// stdout
1 2 3 3 5 7 8 9 
9 8 7 5 3 3 2 1 
7 5
//// case: malloc_free_calloc_realloc
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
int main(void) {
    int *a = malloc(5 * sizeof *a);
    for (int i = 0; i < 5; i++) a[i] = i * 10;
    a = realloc(a, 10 * sizeof *a);
    for (int i = 5; i < 10; i++) a[i] = i * 10;
    long s = 0;
    for (int i = 0; i < 10; i++) s += a[i];
    printf("%ld\n", s);
    free(a);
    int *z = calloc(8, sizeof *z);
    int allzero = 1;
    for (int i = 0; i < 8; i++) if (z[i]) allzero = 0;
    printf("%d\n", allzero);
    free(z);
    char *s2 = malloc(16);
    strcpy(s2, "dynamic");
    printf("%s %zu\n", s2, strlen(s2));
    free(s2);
    return 0;
}
//// stdout
450
1
dynamic 7
//// case: string_library
#include <stdio.h>
#include <string.h>
int main(void) {
    char a[32] = "hello";
    char b[32];
    strcpy(b, a);
    strcat(b, " world");
    printf("%s|%zu|%d|%d\n", b, strlen(b), strcmp(a, b) < 0, strcmp(b, b));
    printf("%d %d\n", strncmp("abcdef", "abcxyz", 3), strncmp("abcdef", "abcxyz", 4) < 0);
    char *p = strchr(b, 'o');
    char *q = strrchr(b, 'o');
    printf("%ld %ld\n", (long)(p - b), (long)(q - b));
    char *r = strstr(b, "wor");
    printf("%s\n", r);
    char buf[16];
    memset(buf, 'x', 5);
    buf[5] = 0;
    printf("%s\n", buf);
    memcpy(buf, "AB", 2);
    printf("%s %d\n", buf, memcmp("abc", "abd", 3) < 0);
    return 0;
}
