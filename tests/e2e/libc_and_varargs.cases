int main(void) {
    char a[] = "abc";
    char *b = "abc";
    a[0] = 'X';
    printf("%s %s %zu %zu\n", a, b, sizeof a, sizeof b);
    char two[2][4] = {"ab", "cde"};
    printf("%s %s %c\n", two[0], two[1], two[1][2]);
