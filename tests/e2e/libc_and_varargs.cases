//// case: atoi_strtol_atof
#include <stdio.h>
#include <stdlib.h>
int main(void) {
    printf("%d %ld %ld\n", atoi("123abc"), strtol("ff", NULL, 16), strtol("-0777", NULL, 0));
    char *end;
    long v = strtol("42 rest", &end, 10);
    printf("%ld [%s]\n", v, end);
    printf("%.2f %.2f\n", atof("3.75"), strtod("1e3x", &end));
    printf("%d %d %d\n", abs(-5), (int)labs(-7L), abs(3));
    div_t q = div(17, 5);
    printf("%d %d\n", q.quot, q.rem);
    return 0;
}
