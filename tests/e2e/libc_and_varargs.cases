//// case: ctype_functions
#include <stdio.h>
#include <ctype.h>
int main(void) {
    const char *s = "Hello, World 42!";
    int up = 0, lo = 0, dg = 0, sp = 0, pu = 0;
    for (const char *p = s; *p; p++) {
        if (isupper((unsigned char)*p)) up++;
        if (islower((unsigned char)*p)) lo++;
        if (isdigit((unsigned char)*p)) dg++;
        if (isspace((unsigned char)*p)) sp++;
        if (ispunct((unsigned char)*p)) pu++;
    }
    printf("%d %d %d %d %d\n", up, lo, dg, sp, pu);
    printf("%c %c\n", toupper('a'), tolower('Z'));
    return 0;
}
//// stdout
2 8 2 2 2
A z
//// case: array_of_pointers_and_2d
#include <stdio.h>
int main(void) {
    const char *names[] = {"zero", "one", "two", "three"};
    for (int i = 0; i < 4; i++) printf("%s:%zu ", names[i], sizeof names[i]);
    printf("\n");
    int grid[3][3] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
    int (*row)[3] = grid;
    printf("%d %d %d\n", row[1][1], (*(row + 2))[0], *(*(grid + 0) + 2));
    int *flat = &grid[0][0];
    int t = 0;
    for (int i = 0; i < 9; i++) t += flat[i];
    printf("%d\n", t);
    char *argv[] = {"prog", "-v", 0};
    int argc = 0;
    while (argv[argc]) argc++;
    printf("%d\n", argc);
    return 0;
}
