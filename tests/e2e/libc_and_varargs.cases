//// case: exit_and_atexit
#include <stdio.h>
#include <stdlib.h>
static void bye(void) { printf("bye\n"); }
int main(void) {
    atexit(bye);
    printf("running\n");
    if (1) exit(3);
    printf("unreachable\n");
    return 0;
}
