//// case: void_pointer_and_casts
#include <stdio.h>
#include <string.h>
static void fill(void *p, int c, size_t n) { unsigned char *b = p; while (n--) *b++ = (unsigned char)c; }
int main(void) {
    int x[4];
    fill(x, 0xFF, sizeof x);
    printf("%d %u\n", x[0], (unsigned)x[3]);
    long v = 0x0102030405060708L;
    unsigned char *b = (unsigned char *)&v;
    printf("%d %d\n", b[0], b[7]);
    void *vp = &v;
    long *lp = vp;
    printf("%lx\n", *lp);
    double d = 1.5;
    unsigned long bits;
    memcpy(&bits, &d, sizeof bits);
    printf("%lx\n", bits);
    return 0;
}
