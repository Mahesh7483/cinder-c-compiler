//// case: integer_overflow_signed_via_unsigned
#include <stdio.h>
int main(void) {
    unsigned a = 2147483647u;
    int b = (int)(a + 1u);
    printf("%d\n", b);
    long c = (long)9223372036854775807UL;
    printf("%ld\n", c);
    int d = (int)3000000000u;
    printf("%d\n", d);
    return 0;
}
//// stdout
-2147483648
9223372036854775807
-1294967296
//// case: const_expression_folding
#include <stdio.h>
#define N (3 * 4 + 2)
int arr[N];
int main(void) {
    printf("%zu %d %d\n", sizeof arr / sizeof arr[0], 100 / 7, 100 % 7);
    printf("%d %d\n", (1 << 10) - 1, ~0 >> 28);
    printf("%d\n", sizeof(int) * 3 > 10 ? 1 : 0);
    printf("%.2f\n", 1.0 / 3 * 3);
    return 0;
}
//// stdout
14 14 2
1023 -1
1
1.00
//// case: long_double_free_float_formats
#include <stdio.h>
int main(void) {
    double d = 1234.5678;
    printf("%f|%.0f|%.3f|%10.2f|%-10.1f|%e\n", d, d, d, d, d, d);
    printf("%g %g %g\n", 0.0001, 100000.0, 1e-10);
    float f = 2.5f;
    printf("%f %g\n", f, f);
    return 0;
}
//// stdout
1234.567800|1235|1234.568|   1234.57|1234.6    |1.234568e+03
0.0001 100000 1e-10
2.500000 2.5
