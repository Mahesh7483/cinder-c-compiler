//// case: opt_loop_invariant_motion_respects_stores
#include <stdio.h>
int g = 5;
int arr[8];
static int bump(int n) {
    int s = 0;
    for (int i = 0; i < n; i++) {
        s += g * 2;
        g += 1;
    }
    return s;
}
static int through_pointer(int *p, int n) {
    int s = 0;
    for (int i = 0; i < n; i++) {
        s += *p;
        arr[0] = i;
    }
    return s;
}
int main(void) {
    int r = bump(6);
    printf("%d %d\n", r, g);
    arr[0] = 100;
    printf("%d\n", through_pointer(&arr[0], 5));
    printf("%d\n", through_pointer(&arr[1], 5));
    return 0;
}
