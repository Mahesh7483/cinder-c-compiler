//// case: opt_inlined_functions_with_loops_and_early_returns
#include <stdio.h>
static int find(const int *a, int n, int x) {
    for (int i = 0; i < n; i++)
        if (a[i] == x) return i;
    return -1;
}
static int clamp(int v, int lo, int hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}
static int sum_to(int n) {
    int s = 0;
    for (int i = 1; i <= n; i++) s += i;
    return s;
}
int main(void) {
    int a[] = {5, 3, 9, 1, 7};
    int t = 0;
    for (int i = -2; i < 12; i++) t += find(a, 5, i) + clamp(i, 0, 8) + sum_to(clamp(i, 0, 5));
    printf("%d\n", t);
    return 0;
}
