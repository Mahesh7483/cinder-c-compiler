//// case: opt_tail_call_swaps_arguments
#include <stdio.h>
static long show(long a, long b, long c, long d, long e, long f) { return a * 1 + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000; }
long rotate(long a, long b, long c, long d, long e, long f) { return show(f, a, b, c, d, e); }
long reverse(long a, long b, long c, long d, long e, long f) { return show(f, e, d, c, b, a); }
double mix(double a, long n, double b) { return a * 2 + n + b / 2; }
double mix_tail(long n, double b, double a) { return mix(a, n, b); }
int main(void) {
    printf("%ld %ld\n", rotate(1, 2, 3, 4, 5, 6), reverse(1, 2, 3, 4, 5, 6));
    printf("%.2f\n", mix_tail(5, 3.0, 1.5));
    return 0;
}
