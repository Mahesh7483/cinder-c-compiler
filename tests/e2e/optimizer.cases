int main(void) {
    long sum = 0;
    for (int x = -300; x <= 300; x++) {
        sum += x / 2 + x / 4 * 3 + x / 8 * 5 + x / 64 * 7;
        sum += (x % 2) * 11 + (x % 4) * 13 + (x % 8) * 17 + (x % 64) * 19;
    }
    printf("%ld\n", sum);
    int m = -2147483647 - 1;
    printf("%d %d %d %d\n", m / 2, m % 8, m / 65536, m % 65536);
    int p = 2147483647;
    printf("%d %d %d %d\n", p / 2, p % 8, p / 1073741824, p % 1073741824);
    for (int x = -9; x <= 9; x += 3) printf("%d:%d,%d,%d ", x, x / 4, x % 4, -x / 4);
    printf("\n");
    long long big = -9223372036854775807LL - 1;
    printf("%lld %lld %lld\n", big / 2, big % 16, (big + 12345) / 1024);
    return 0;
}
