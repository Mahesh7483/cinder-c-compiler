//// case: opt_switch_on_constants_and_variables
#include <stdio.h>
static int classify(int v) {
    switch (v) {
    case 0: return 10;
    case 1:
    case 2: return 20;
    case 5: v += 100;
    case 6: return v;
    default: return -1;
    }
}
int main(void) {
    int t = 0;
    for (int i = -1; i < 9; i++) t = t * 3 + classify(i);
    printf("%d\n", t);
    switch (3) { case 3: printf("three\n"); break; case 4: printf("four\n"); }
    int k = 4;
    switch (k) { case 3: printf("three\n"); break; case 4: printf("four\n"); default: printf("fall\n"); }
    return 0;
}
