#include <stdio.h>
#include <math.h>
static int ge(double a, double b) { return !(a < b); }
static int ne(double a, double b) { return (a == b) == 0; }
static int le(double a, double b) { return (a > b) == 0; }
int main(void) {
    double nan = NAN, one = 1.0, two = 2.0;
    printf("%d %d %d\n", ge(one, two), ge(two, one), ge(nan, one));
    printf("%d %d %d\n", ne(one, one), ne(one, two), ne(nan, nan));
    printf("%d %d %d\n", le(one, two), le(two, one), le(nan, one));
    printf("%d %d\n", nan != nan, !(nan == nan));
    return 0;
}
