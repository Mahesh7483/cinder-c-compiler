//// case: opt_constants_fold_like_the_hardware
#include <stdio.h>
static int id(int x) { return x; }
int main(void) {
    int a = id(2147483647);
    unsigned u = (unsigned)a + 1u;
    printf("%d %u\n", a + 0, u);
    signed char sc = (signed char)id(200);
    unsigned char uc = (unsigned char)id(300);
    short sh = (short)id(70000);
    printf("%d %d %d\n", sc, uc, sh);
    printf("%d %d %d\n", -7 / 2, -7 % 2, 7 / -2);
    printf("%d %d\n", 1 << 30, -16 >> 2);
    printf("%d %d %d\n", -1 < 0u, -1 < 0, (unsigned char)255 == 255);
    printf("%d %d\n", (int)-2.9, (int)2.9);
    printf("%.1f %.1f\n", (double)(float)16777217, (double)(float)0.1);
    float f = 16777216.0f;
    printf("%.1f %.1f\n", f + 1.0f, f + 2.0f);
    long long big = 9007199254740993LL;
    printf("%.1f %.1f\n", (double)big, (double)(float)big);
    printf("%lld %llu\n", (long long)(unsigned char)id(-1), (unsigned long long)(int)id(-1));
    printf("%d\n", id(5) * id(-3) + id(7) % id(4) - (id(9) ^ id(5)) + (id(12) & id(10)) + (id(1) | id(6)));
