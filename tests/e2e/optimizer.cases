//// case: opt_tail_recursion_is_a_loop
#include <stdio.h>
static long sum_to(long n, long acc) {
    if (n == 0) return acc;
    return sum_to(n - 1, acc + n);
}
static long collatz(long n, long steps) {
    if (n == 1) return steps;
    return collatz(n % 2 ? 3 * n + 1 : n / 2, steps + 1);
}
int main(void) {
    printf("%ld\n", sum_to(50000000L, 0));
    printf("%ld\n", collatz(27, 0));
    return 0;
}
