//// case: opt_register_pressure_after_inlining
#include <stdio.h>
static long mixer(long a, long b, long c, long d) { return (a ^ b) + (c & d) * 3 + (a | d) - (b << 2); }
int main(void) {
    long v[12];
    for (int i = 0; i < 12; i++) v[i] = i * 7 + 3;
    long acc = 0;
    for (int r = 0; r < 50; r++) {
        long a = v[0] + r, b = v[1] - r, c = v[2] * 2, d = v[3] + 1, e = v[4], f = v[5], g = v[6], h = v[7];
        long i = v[8], j = v[9], k = v[10], l = v[11];
        acc += mixer(a, b, c, d) + mixer(e, f, g, h) + mixer(i, j, k, l) + mixer(a + e, b + f, c + g, d + h);
        acc += a + b + c + d + e + f + g + h + i + j + k + l;
        v[r % 12] += acc & 15;
    }
    printf("%ld\n", acc);
    return 0;
}
