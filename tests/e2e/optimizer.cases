//// case: opt_tail_call_restores_callee_saved_registers
#include <stdio.h>
long leaf(long x) { return x * 3 + 1; }
long busy(long a, long b, long c, long d, long e) {
    long t1 = a * b, t2 = b * c, t3 = c * d, t4 = d * e, t5 = e * a;
    long r = leaf(t1 + t2) + t3 + t4 + t5;
    r += leaf(r) % 7;
    return leaf(r + t1 - t5);
}
int main(void) {
    long keep1 = 11, keep2 = 22, keep3 = 33, keep4 = 44;
    long r = busy(1, 2, 3, 4, 5);
    keep1 += r;
    keep2 += busy(5, 4, 3, 2, 1);
    printf("%ld %ld %ld %ld %ld\n", r, keep1, keep2, keep3, keep4);
    return 0;
}
