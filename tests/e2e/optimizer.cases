#include <stdio.h>
struct ops { long (*step[2])(const struct ops *, long, long); };
static long ping(const struct ops *t, long n, long acc) { return n == 0 ? acc : t->step[1](t, n - 1, acc + 1); }
static long pong(const struct ops *t, long n, long acc) { return n == 0 ? acc : t->step[0](t, n - 1, acc + 2); }
int main(void) {
    struct ops t = {{ping, pong}};
    printf("%ld\n", t.step[0](&t, 30000000, 0));
    return 0;
}
