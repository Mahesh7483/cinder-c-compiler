//// case: expr_shifts_and_bitwise
#include <stdio.h>
int main(void) {
    int n = -8;
    unsigned u = 0x80000001u;
    long long big = -1LL;
    printf("%d %d %u %u\n", n >> 1, n >> 3, u >> 1, u >> 31);
    printf("%d %u %lld %llu\n", 1 << 10, 1u << 31, 1LL << 40, (unsigned long long)big >> 60);
    printf("%x %x %x %x\n", 0xf0f0 & 0xff00, 0xf0f0 | 0x0f0f, 0xf0f0 ^ 0xffff, ~0xf0f0 & 0xffff);
    int bits = 0;
    for (unsigned v = 0xdeadbeef; v; v &= v - 1) bits++;
    printf("%d\n", bits);
    for (int i = 0; i < 8; i++) printf("%d", (0xa5 >> i) & 1);
    printf("\n");
    int k = 5;
    printf("%d %d %d\n", 1 << k, 0x100 >> k, (1 << k) - 1);
    return 0;
}
