//// case: expr_short_circuit_and_conditional
#include <stdio.h>
static int n;
static int tick(int v) { n++; return v; }
int main(void) {
    int a = tick(0) && tick(1);
    int b = tick(1) || tick(1);
    int c = tick(1) && tick(0) || tick(1);
    int d = tick(0) ? tick(5) : tick(6);
    printf("%d %d %d %d %d\n", a, b, c, d, n);
    int *p = 0;
    if (p && *p > 3) printf("deref\n"); else printf("safe\n");
    int x = 5;
    int y = x > 3 ? x < 10 ? 1 : 2 : 3;
    printf("%d\n", y);
    double e = x ? 1 : 2.5;
    printf("%.1f %d\n", e, (x ? 'a' : 0));
    long l = 1 ? -1 : 0u;
    printf("%ld\n", l);
    return 0;
}
//// stdout
0 1 1 6 7
safe
1
1.0 97
4294967295
//// case: expr_compound_assignment_conversions
#include <stdio.h>
int main(void) {
    int i = 10;
    i += 2.7;
    i -= 0.5;
    printf("%d\n", i);
    unsigned char u = 250;
    u += 10;
    u *= 2;
    printf("%d\n", u);
    short s = 1000;
    s *= 100;
    printf("%d\n", s);
    double d = 7;
    d /= 2;
    d -= 1;
    printf("%.2f\n", d);
    int j = 17;
    j /= 2.0;
    j %= 5;
    j <<= 3;
    j >>= 1;
    j |= 3;
    j &= ~1;
    j ^= 0xf;
    printf("%d\n", j);
    float f = 1;
    f /= 3;
    f *= 3;
    printf("%.4f %d\n", f, f == 1.0f);
    long l = 1;
    l <<= 40;
    l += 5;
    printf("%ld\n", l);
    char c = 'a';
    c += 1.9;
    printf("%c\n", c);
    return 0;
}
