//// case: expr_integer_promotions_and_narrow_arithmetic
#include <stdio.h>
int main(void) {
    unsigned char a = 200, b = 100;
    signed char s = 100, t = 100;
    unsigned short us = 65535;
    printf("%d %d %d\n", a + b, s + t, us + 1);
    printf("%d %d\n", ~a, ~us);
    unsigned char r = a + b;
    signed char q = s + t;
    printf("%d %d\n", r, q);
    a += 100;
    s += 100;
    us++;
    printf("%d %d %d\n", a, s, us);
    char c = 'x';
    c -= 'a' - 'A';
    printf("%c %d\n", c, c << 4);
    short m = 32767;
    m++;
    printf("%d\n", m);
    unsigned char sh = 1;
    sh <<= 7;
    printf("%d %d\n", sh, sh << 1);
    return 0;
}
//// stdout
300 200 65536
-201 -65536
44 -56
44 -56 0
X 1408
-32768
