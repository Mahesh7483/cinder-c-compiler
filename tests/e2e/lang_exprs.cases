//// case: expr_increment_decrement_forms
#include <stdio.h>
int main(void) {
    int a = 5;
    int b = a++;
    b += a++;
    int c = ++a + 1;
    printf("%d %d %d\n", a, b, c);
    int arr[4] = {10, 20, 30, 40};
    int *p = arr;
    int x = *p++;
    int y = *++p;
    int z = (*p)++;
    printf("%d %d %d %d %d\n", x, y, z, arr[2], (int)(p - arr));
    double d = 1.5;
    d++;
    --d;
    d += 0.25;
    float f = 2;
    f *= 1.5f;
    printf("%.2f %.2f\n", d, f);
    char s[] = "abc";
    char *q = s;
    q++;
    (*q)++;
    printf("%s %d\n", s, (int)(q - s));
    unsigned char uc = 255;
    uc++;
    printf("%d\n", uc);
    return 0;
}
//// stdout
8 11 9
10 30 30 31 2
1.75 3.00
acc 1
0
//// case: expr_pointer_arithmetic_and_comparison
#include <stdio.h>
struct S { int a; char b; double c; };
int main(void) {
    int a[10];
    for (int i = 0; i < 10; i++) a[i] = i * 11;
    int *p = &a[2], *q = &a[7];
    printf("%d %d %d %d\n", (int)(q - p), *(p + 3), p[4], *(q - 2));
    printf("%d %d %d %d\n", p < q, p == q, p >= q, p != &a[2]);
    struct S s[3];
    struct S *sp = s;
    printf("%d %d %d\n", (int)((char *)(sp + 2) - (char *)sp), (int)(&s[2] - &s[0]), (int)sizeof(struct S));
    char *cp = (char *)a;
    printf("%d %d\n", *(int *)(cp + 8), (int)((cp + 20) - cp));
    int *np = 0;
    printf("%d %d %d\n", np == 0, !np, np == NULL);
    p += 2;
    q -= 3;
    printf("%d %d %ld\n", *p, *q, (long)(q - p));
    int (*pa)[10] = &a;
    printf("%d %d\n", (*pa)[9], (int)(*(pa + 1) - *pa));
    return 0;
}
//// stdout
5 55 66 55
1 0 0 0
32 2 16
22 20
1 1 1
44 44 0
