//// case: expr_bool_conversions
#include <stdio.h>
#include <stdbool.h>
int main(void) {
    bool a = 256, b = -1, c = 0.1, d = 0.0, e = (void *)0;
    int x = 3;
    bool f = &x;
    _Bool g = (char)256;
    printf("%d %d %d %d %d %d %d\n", a, b, c, d, e, f, g);
    bool h = true;
    h++;
    h += 5;
    printf("%d %d\n", h, !h);
    printf("%d %d %d\n", true + true, (int)sizeof(true), false);
    int arr[3] = {0, 5, 0};
    int count = 0;
    for (int i = 0; i < 3; i++) count += !!arr[i];
    printf("%d\n", count);
    return 0;
}
//// stdout
1 1 1 0 0 1 0
1 0
2 4 0
1
//// case: expr_char_signedness_and_literals
#include <stdio.h>
int main(void) {
    char c = 200;
    unsigned char u = 200;
    signed char s = 200;
    printf("%d %d %d\n", c, u, s);
    printf("%d %d\n", c == 200, u == 200);
    char neg = '\377';
    printf("%d %d\n", neg, neg < 0);
    int x = 'ab';
    printf("%d\n", x);
    char buf[4] = {65, 66, 67, 0};
    printf("%s %c %d\n", buf, buf[1] + 1, buf[2] - 'A');
    printf("%d %d %d\n", 'a' < 'b', '0' + 5, "xyz"[1]);
    return 0;
}
