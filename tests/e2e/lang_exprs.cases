//// case: expr_division_modulo_semantics
#include <stdio.h>
#include <limits.h>
int main(void) {
    printf("%d %d %d %d\n", 7 / 2, -7 / 2, 7 / -2, -7 / -2);
    printf("%d %d %d %d\n", 7 % 3, -7 % 3, 7 % -3, -7 % -3);
    printf("%u %u\n", 7u / 2u, 4294967295u % 10u);
    printf("%ld %ld\n", -9000000000000L / 7, -9000000000000L % 7);
    printf("%d %d\n", INT_MIN / 2, INT_MIN % 3);
    long long a = LLONG_MIN;
    printf("%lld %lld\n", a / 2, a % 10);
    unsigned long long b = 18446744073709551615ull;
    printf("%llu %llu\n", b / 3, b % 1000);
    int d = 3;
    printf("%d %d %d\n", 100 / d, -100 / d, 100 % d);
    return 0;
}
