//// case: expr_array_decay_and_sizeof
#include <stdio.h>
static int sz(int a[10]) { return (int)sizeof(a); }
static int sz2(int (*a)[10]) { return (int)sizeof(*a); }
int main(void) {
    int a[10];
    int m[3][5];
    char s[] = "hello";
    printf("%d %d %d %d\n", (int)sizeof(a), sz(a), sz2(&a), (int)sizeof(m));
    printf("%d %d %d %d\n", (int)sizeof(m[0]), (int)sizeof(m[0][0]), (int)sizeof(s), (int)sizeof(&s));
    printf("%d %d %d\n", (int)(sizeof(a) / sizeof(a[0])), (int)sizeof(a + 1), (int)sizeof(*a));
    printf("%d %d\n", (int)sizeof(int[7]), (int)sizeof(char *[4]));
    printf("%d %d\n", (int)sizeof 1, (int)sizeof(1 + 1.0));
    int i = 0;
    int z = (int)sizeof(i++);
    printf("%d %d\n", z, i);
    return 0;
}
