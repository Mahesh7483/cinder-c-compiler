//// case: expr_comma_and_void_casts
#include <stdio.h>
int main(void) {
    int i, j;
    for (i = 0, j = 10; i < j; i += 3, j -= 2) printf("%d,%d ", i, j);
    printf("\n");
    int x = (1, 2, 3);
    (void)x;
    (void)printf("%d\n", x);
    int y = (x++, x++, x);
    printf("%d %d\n", x, y);
    return 0;
}
