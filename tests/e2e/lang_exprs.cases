//// case: expr_float_conversions
#include <stdio.h>
#include <math.h>
int main(void) {
    printf("%d %d %d %d\n", (int)3.99, (int)-3.99, (int)0.5, (int)-0.5);
    printf("%u %ld %lu\n", (unsigned)3000000000.0, (long)-1e18, (unsigned long)1.8e19);
    printf("%.1f %.1f %.1f\n", (double)3, (double)-5L, (double)18446744073709551615UL);
    printf("%.2f %.2f\n", (float)0.1, (double)(float)0.1);
    printf("%d %d %d\n", (char)-100.9, (unsigned char)255.9, (short)-32768.5);
    double inf = INFINITY, nan = NAN;
    printf("%d %d %d %d\n", inf > 1e308, -inf < -1e308, nan == nan, nan != nan);
    printf("%.0f %.0f %.0f %.0f\n", floor(-2.5), ceil(-2.5), round(2.5), trunc(-2.7));
    unsigned long big = 9223372036854775808UL;
    printf("%.1f %.1f\n", (double)big, (double)(big + 4096));
    float f = 16777216.0f;
    printf("%.1f %.1f %d\n", f + 1.0f, (double)f + 1.0, (int)(f + 1.0f));
    printf("%g %g %g\n", 1e-5, 123456789.0, 0.0001);
    printf("%e %f\n", 12345.6789, 1e10);
    return 0;
}
