//// case: expr_precedence_and_associativity
#include <stdio.h>
int main(void) {
    int a = 2, b = 3, c = 4, d = 5;
    printf("%d %d %d %d\n", a + b * c, (a + b) * c, a - b - c, a * b % c);
    printf("%d %d %d %d\n", a << 1 + 1, a < b == c > d, a & b | c ^ d, !a + ~b);
    printf("%d %d %d\n", a ? b : c ? d : 0, a || b && c, -a * -b);
    printf("%d %d %d %d\n", 10 / 3 * 3, 10 % 4 * 2, 1 + 2 << 3, 100 >> 2 + 1);
    int x = (a = 5, b = a + 1, b * 2);
    printf("%d %d %d\n", x, a, b);
    int y, z;
    y = z = 7;
    y += z -= 3;
    printf("%d %d\n", y, z);
    return 0;
}
//// stdout
14 20 -5 2
8 0 3 -4
3 1 6
9 4 24 12
12 5 6
11 4
//// case: expr_usual_arithmetic_conversions
#include <stdio.h>
int main(void) {
    int i = -1;
    unsigned u = 1;
    long l = -1;
    unsigned long ul = 1;
    char c = -1;
    unsigned char uc = 255;
    short s = -2;
    printf("%d %d %d\n", i < u, l < ul, c < uc);
    printf("%d %d %d\n", (int)sizeof(c + c), (int)sizeof(uc + 1L), (int)sizeof(s * 1u));
    printf("%d %d\n", uc + 1, c + uc);
    printf("%u %lu\n", i + u, l + ul);
    printf("%d %d\n", (unsigned char)(uc + 1), (signed char)(uc));
    printf("%d %d %d\n", -1 > 0u, -1L > 0u, -1 > 0ul);
    printf("%.2f %.2f %.2f\n", 1 / 2.0, 1 / 2 + 0.5, (float)1 / 3);
    printf("%d %d\n", (short)40000, (int)(char)200);
    long long ll = 1LL << 40;
    printf("%lld %d %d\n", ll, (int)ll, (int)(ll >> 38));
    return 0;
}
