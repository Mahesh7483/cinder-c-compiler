//// case: integer_arithmetic
#include <stdio.h>
int main(void) {
    int a = 17, b = 5;
    printf("%d %d %d %d %d\n", a + b, a - b, a * b, a / b, a % b);
    printf("%d %d %d\n", -a, ~a, !a);
    printf("%d %d %d %d %d\n", a & b, a | b, a ^ b, a << 2, a >> 1);
    return 0;
}
