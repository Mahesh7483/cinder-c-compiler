//// case: break_and_continue
#include <stdio.h>
int main(void) {
    int sum = 0;
    for (int i = 0; i < 20; i++) {
        if (i % 2) continue;
        if (i > 12) break;
        sum += i;
    }
    printf("%d\n", sum);
    int found = -1;
    for (int i = 0; i < 5; i++)
        for (int j = 0; j < 5; j++)
            if (i * j == 6) { found = i * 10 + j; goto done; }
done:
    printf("%d\n", found);
    return 0;
}
//// stdout
42
23
//// case: switch_statement
#include <stdio.h>
static int f(int x) {
    switch (x) {
    case 1: return 10;
    case 2:
    case 3: return 20;
    case 4: x += 100;
    case 5: return x;
    default: return -1;
    }
}
int main(void) {
    for (int i = 0; i < 8; i++) printf("%d ", f(i));
    printf("\n");
    int v = 3, r = 0;
    switch (v) { case 3: r += 1; case 4: r += 10; break; case 5: r += 100; }
    printf("%d\n", r);
    return 0;
}
//// stdout
-1 10 20 20 104 5 -1 -1 
