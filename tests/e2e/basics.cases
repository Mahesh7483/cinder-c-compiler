//// case: strings_basic
#include <stdio.h>
static int my_strlen(const char *s) { int n = 0; while (*s++) n++; return n; }
static void my_strcpy(char *d, const char *s) { while ((*d++ = *s++)); }
int main(void) {
    char buf[32];
    my_strcpy(buf, "copy me");
    printf("[%s] %d\n", buf, my_strlen(buf));
    const char *p = "literal";
    printf("%s %c %d\n", p, p[2], my_strlen(p));
    char r[6] = "hello";
    for (int i = 0; i < 5 / 2; i++) { char t = r[i]; r[i] = r[4 - i]; r[4 - i] = t; }
    printf("%s\n", r);
    return 0;
}
//// stdout
[copy me] 7
literal t 7
olleh
