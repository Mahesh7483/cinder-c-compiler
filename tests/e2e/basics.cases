//// case: pointers_basic
#include <stdio.h>
static void swap(int *a, int *b) { int t = *a; *a = *b; *b = t; }
int main(void) {
    int x = 3, y = 9;
    int *p = &x;
    *p = 10;
    swap(&x, &y);
    printf("%d %d\n", x, y);
    int **pp = &p;
    **pp += 5;
    printf("%d\n", x);
    int arr[4] = {10, 20, 30, 40};
    int *q = arr;
    printf("%d %d %d\n", *q, *(q + 2), q[3]);
    q += 2;
    printf("%d %ld\n", *q, (long)(q - arr));
    return 0;
}
//// stdout
9 10
14
10 30 40
30 2
//// case: pointer_arithmetic_types
#include <stdio.h>
int main(void) {
    char c[8] = "abcdefg";
    short s[4] = {1, 2, 3, 4};
    long l[3] = {100, 200, 300};
    char *pc = c; short *ps = s; long *pl = l;
    printf("%c %d %ld\n", *(pc + 3), *(ps + 2), *(pl + 1));
    printf("%ld %ld %ld\n", (char *)(pc + 5) - c, (char *)(ps + 3) - (char *)s, (char *)(pl + 2) - (char *)l);
    printf("%d\n", (int)(&s[3] - &s[1]));
    return 0;
}
//// stdout
d 3 200
5 6 16
