//// case: functions_and_arguments
#include <stdio.h>
static int add(int a, int b) { return a + b; }
static int mul3(int a, int b, int c) { return a * b * c; }
static int many(int a, int b, int c, int d, int e, int f, int g, int h) { return a + 2*b + 3*c + 4*d + 5*e + 6*f + 7*g + 8*h; }
static void greet(const char *name) { printf("hi %s\n", name); }
int main(void) {
    printf("%d %d\n", add(3, 4), mul3(2, 3, 4));
    printf("%d\n", many(1, 2, 3, 4, 5, 6, 7, 8));
    greet("there");
    printf("%d\n", add(add(1, 2), add(3, 4)));
    return 0;
}
//// stdout
7 24
204
hi there
10
//// case: recursion_factorial_fibonacci
#include <stdio.h>
static long fact(int n) { return n <= 1 ? 1 : n * fact(n - 1); }
static int fib(int n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); }
static int gcd(int a, int b) { return b == 0 ? a : gcd(b, a % b); }
int main(void) {
    for (int i = 0; i <= 10; i++) printf("%d! = %ld, fib = %d\n", i, fact(i), fib(i));
    printf("%d\n", gcd(1071, 462));
    return 0;
}
//// stdout
0! = 1, fib = 0
1! = 1, fib = 1
2! = 2, fib = 1
3! = 6, fib = 2
4! = 24, fib = 3
5! = 120, fib = 5
6! = 720, fib = 8
7! = 5040, fib = 13
8! = 40320, fib = 21
9! = 362880, fib = 34
10! = 3628800, fib = 55
21
//// case: mutual_recursion
#include <stdio.h>
static int is_odd(int n);
static int is_even(int n) { return n == 0 ? 1 : is_odd(n - 1); }
static int is_odd(int n) { return n == 0 ? 0 : is_even(n - 1); }
int main(void) {
    printf("%d %d %d %d\n", is_even(10), is_odd(10), is_even(7), is_odd(7));
    return 0;
}
//// stdout
1 0 0 1
//// case: global_variables
#include <stdio.h>
int counter = 100;
int zero_init;
static int hidden = 7;
const int limit = 25;
int next_id(void) { return counter++; }
int main(void) {
    printf("%d %d %d %d\n", counter, zero_init, hidden, limit);
    next_id(); next_id();
    printf("%d\n", counter);
    zero_init = 5;
    hidden *= 2;
    printf("%d %d\n", zero_init, hidden);
    return 0;
}
//// stdout
100 0 7 25
102
5 14
//// case: static_local_variables
#include <stdio.h>
static int tick(void) { static int n = 0; return ++n; }
static int fresh(void) { int n = 0; return ++n; }
int main(void) {
    for (int i = 0; i < 4; i++) printf("%d/%d ", tick(), fresh());
    printf("\n");
    return 0;
}
//// stdout
1/1 2/1 3/1 4/1 
//// case: arrays_basic
#include <stdio.h>
int main(void) {
    int a[5] = {5, 4, 3, 2, 1};
    int sum = 0;
    for (int i = 0; i < 5; i++) sum += a[i] * (i + 1);
    printf("%d\n", sum);
    int b[10];
    for (int i = 0; i < 10; i++) b[i] = i * i;
    printf("%d %d %d\n", b[0], b[5], b[9]);
    int m[3][4];
    for (int i = 0; i < 3; i++) for (int j = 0; j < 4; j++) m[i][j] = i * 4 + j;
    printf("%d %d %d\n", m[0][0], m[1][2], m[2][3]);
    printf("%zu %zu %zu\n", sizeof a, sizeof b / sizeof b[0], sizeof m);
    return 0;
}
