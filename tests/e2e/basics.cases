//// case: ternary_and_short_circuit
#include <stdio.h>
static int calls = 0;
static int side(int v) { calls++; return v; }
int main(void) {
    int a = 5, b = 9;
    printf("%d %d\n", a > b ? a : b, a < b ? a : b);
    printf("%d\n", side(0) && side(1));
    printf("%d\n", side(1) || side(1));
    int r = side(1) && side(2);
    printf("%d %d\n", r, calls);
    int x = a > 3 ? (b > 3 ? 1 : 2) : 3;
    printf("%d\n", x);
    return 0;
}
//// stdout
9 5
0
1
1 4
1
//// case: comma_and_conditional_expressions
#include <stdio.h>
int main(void) {
    int a = (1, 2, 3);
    int b, c;
    b = (c = 4, c + 1);
    printf("%d %d %d\n", a, b, c);
    int i, j;
    for (i = 0, j = 10; i < j; i += 3, j -= 3) printf("%d,%d ", i, j);
    printf("\n");
    return 0;
}
