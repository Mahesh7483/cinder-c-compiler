//// case: local_variables_and_assignment
#include <stdio.h>
int main(void) {
    int x = 10, y = 20, z;
    z = x + y;
    x = y = 5;
    int w = (z = 3) + 4;
    printf("%d %d %d %d\n", x, y, z, w);
    x += 3; x -= 1; x *= 4; x /= 3; x %= 5;
    printf("%d\n", x);
    x = 6; x <<= 2; x >>= 1; x &= 0xE; x |= 1; x ^= 3;
    printf("%d\n", x);
    return 0;
}
//// stdout
5 5 3 7
4
14
//// case: increment_decrement
#include <stdio.h>
int main(void) {
    int i = 5;
    printf("%d ", i++);
    printf("%d ", i);
    printf("%d ", ++i);
    printf("%d ", i--);
    printf("%d ", --i);
    printf("%d\n", i);
    char c = 'a';
    c++;
    printf("%c\n", c);
    return 0;
}
//// stdout
5 6 7 7 5 5
b
//// case: if_else_chain
#include <stdio.h>
static const char *classify(int n) {
    if (n < 0) return "negative";
    else if (n == 0) return "zero";
    else if (n < 10) return "small";
    else if (n < 100) return "medium";
    return "large";
}
int main(void) {
    int tests[] = {-5, 0, 7, 50, 1000};
    for (int i = 0; i < 5; i++) printf("%d: %s\n", tests[i], classify(tests[i]));
    return 0;
}
//// stdout
-5: negative
0: zero
7: small
50: medium
1000: large
//// case: while_and_do_while
#include <stdio.h>
int main(void) {
    int i = 0, sum = 0;
    while (i < 10) { sum += i; i++; }
    printf("%d\n", sum);
    int n = 0;
    do { n++; } while (n < 5);
    printf("%d\n", n);
    do { n--; } while (0);
    printf("%d\n", n);
    return 0;
}
//// stdout
45
5
4
//// case: for_loops_and_nesting
#include <stdio.h>
int main(void) {
    for (int i = 1; i <= 4; i++) {
        for (int j = 1; j <= i; j++) printf("%d ", i * j);
        printf("\n");
    }
    int count = 0;
    for (;;) { if (++count == 7) break; }
    printf("%d\n", count);
    return 0;
}
