//// case: operator_precedence
#include <stdio.h>
int main(void) {
    printf("%d\n", 2 + 3 * 4 - 6 / 2);
    printf("%d\n", (2 + 3) * (4 - 6) / 2);
    printf("%d\n", 1 << 2 + 1);
    printf("%d\n", 5 & 3 == 3);
    printf("%d\n", 10 - 4 - 3);
    printf("%d\n", 100 / 10 / 5);
    printf("%d\n", 1 + 2 < 4 && 5 > 3 || 0);
    return 0;
}
