//// case: decl_generic_selection
#include <stdio.h>
#define KIND(x) _Generic((x), int: "int", unsigned: "unsigned", long: "long", double: "double", float: "float", char: "char", char *: "char*", default: "other")
int main(void) {
    int i = 0; unsigned u = 0; long l = 0; double d = 0; float f = 0; char c = 0; const char *s = "";
    printf("%s %s %s %s %s %s %s %s\n", KIND(i), KIND(u), KIND(l), KIND(d), KIND(f), KIND(c), KIND((char *)0), KIND(s));
    printf("%s %s %s\n", KIND(1), KIND(1.0), KIND('a'));
    return 0;
}
