//// case: decl_global_initializers_and_tentative_definitions
#include <stdio.h>
int tentative;
int tentative;
int init = 5;
static int s_init = 6;
const int ci = 7;
int arr[4] = {1, 2};
char msg[] = "global";
const char *pmsg = "pointer";
int *pi = &init;
int *pa = &arr[2];
struct P { int x, y; } gp = {3, 4}, *pgp = &gp;
int (*fp)(void);
static int five(void) { return 5; }
int (*fp2)(void) = five;
long big = 1L << 40;
double dd = 1.0 / 4;
int expr = 3 * 4 + (int)sizeof(arr);
int main(void) {
    printf("%d %d %d %d %d %d %d %d\n", tentative, init, s_init, ci, arr[1], arr[3], *pi, *pa);
    printf("%s %s %d %d %d %d\n", msg, pmsg, gp.y, pgp->x, fp == 0, fp2());
    printf("%ld %.2f %d\n", big, dd, expr);
    return 0;
}
