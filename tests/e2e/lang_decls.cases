//// case: decl_struct_layout_and_offsets
#include <stdio.h>
#include <stddef.h>
struct A { char c; int i; char d; };
struct B { char c; char d; short s; int i; };
struct C { double d; char c; };
struct D { char c; double d; char e; };
struct E { char a[3]; short b; char c; long l; };
union U { char c; int i; double d; char buf[10]; };
struct F { int x; union { int a; float b; }; struct { char p, q; }; };
int main(void) {
    printf("%d %d %d %d %d\n", (int)sizeof(struct A), (int)sizeof(struct B), (int)sizeof(struct C), (int)sizeof(struct D), (int)sizeof(struct E));
    printf("%d %d %d %d\n", (int)offsetof(struct A, i), (int)offsetof(struct A, d), (int)offsetof(struct D, d), (int)offsetof(struct E, l));
    printf("%d %d %d\n", (int)sizeof(union U), (int)_Alignof(union U), (int)sizeof(struct F));
    struct F f = {1, {2}, {'a', 'b'}};
    f.b = 1.0f;
    printf("%d %c%c %d\n", f.x, f.p, f.q, f.a == 0x3f800000);
    return 0;
}
