//// case: decl_static_assert_alignof_alignas
#include <stdio.h>
#include <stdalign.h>
#include <stddef.h>
_Static_assert(sizeof(int) == 4, "int is 4 bytes");
_Static_assert(sizeof(void *) == 8, "64-bit");
struct S { char c; alignas(16) int x; };
int main(void) {
    alignas(32) char buf[8];
    printf("%d %d %d %d\n", (int)alignof(double), (int)alignof(struct S), (int)sizeof(struct S), ((unsigned long)buf % 32) == 0);
    printf("%d %d %d\n", (int)_Alignof(char), (int)_Alignof(long long), (int)alignof(max_align_t) >= 8);
    return 0;
}
