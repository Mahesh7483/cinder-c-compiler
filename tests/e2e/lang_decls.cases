//// case: decl_extern_and_multiple_declarations
#include <stdio.h>
extern int shared;
int shared = 11;
static int helper(int);
int use(void);
int main(void) {
    int a = 1, b = 2, *p = &a, arr[2] = {5, 6};
    {
        int a = 100;
        b += a;
    }
    extern int shared;
    printf("%d %d %d %d %d %d\n", a, b, *p, arr[1], shared, helper(3));
    return use();
}
static int helper(int x) { return x * shared; }
int use(void) { return 0; }
//// stdout
1 102 1 6 11 33
//// case: decl_over_aligned_locals_at_any_stack_depth
#include <stdio.h>
#include <stdalign.h>
static int bad;
static int check(int n) {
    char pad[8 + 16 * (n % 5)];
    alignas(32) char a[3];
    alignas(64) int b[4];
    alignas(16) double c;
    pad[0] = (char)n; a[0] = 1; b[0] = 2; c = 3.0;
    if ((unsigned long)a % 32) bad |= 1;
    if ((unsigned long)b % 64) bad |= 2;
    if ((unsigned long)&c % 16) bad |= 4;
    if (n > 0) return check(n - 1) + pad[0] + a[0] + b[0] + (int)c;
    return pad[0] + a[0] + b[0] + (int)c;
}
int main(void) {
    int r = check(37);
    printf("%d %d\n", r, bad);
    return 0;
}
//// stdout
931 0
