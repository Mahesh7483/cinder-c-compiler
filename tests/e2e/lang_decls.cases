//// case: decl_bitfields
#include <stdio.h>
struct flags { unsigned a : 3; unsigned b : 5; int c : 4; unsigned d : 1; unsigned : 0; unsigned e : 7; };
struct packed { unsigned x : 12; unsigned y : 12; unsigned z : 8; };
struct signs { signed char s : 3; int t : 31; };
int main(void) {
    struct flags f = {0};
    f.a = 9;       /* wraps to 1 */
    f.b = 31;
    f.c = -3;
    f.d = 3;       /* wraps to 1 */
    f.e = 100;
    printf("%u %u %d %u %u\n", f.a, f.b, f.c, f.d, f.e);
    f.c += 10;     /* -3 + 10 = 7 -> wraps to 7? (4-bit signed: 7) */
    f.a++;
    f.b -= 40;
    printf("%d %u %u\n", f.c, f.a, f.b);
    struct packed p = {0xabc, 0x123, 0xff};
    p.y ^= 0xfff;
    printf("%x %x %x %d\n", p.x, p.y, p.z, (int)sizeof(p));
    struct signs s = {-4, -100000};
    s.s++;
    printf("%d %d %d\n", s.s, s.t, (int)sizeof(struct flags));
    struct flags *pf = &f;
    pf->e = 5;
    printf("%u\n", pf->e);
    return 0;
}
//// stdout
1 31 -3 1 100
7 2 23
abc edc ff 4
-3 -100000 8
5
//// case: decl_designated_initializers
#include <stdio.h>
struct P { int x, y; };
struct S { int id; struct P pos; char name[8]; int tags[4]; };
int main(void) {
    int a[8] = {[2] = 20, [5] = 50, 60};
    int b[] = {[3] = 1, 2, [0] = 9};
    struct P p = {.y = 5, .x = 3};
    struct S s = {.name = "bob", .pos = {.y = 8}, .tags = {[2] = 7}, .id = 99};
    struct S t = {1, {2, 3}, "al", {4, 5, 6, 7}};
    struct P arr[3] = {[1] = {10, 11}, [2].y = 12};
    char str[] = {'a', 'b', [4] = 'e', 0};
    for (int i = 0; i < 8; i++) printf("%d ", a[i]);
    printf("| %d %d %d %d %d %d\n", (int)(sizeof b / sizeof b[0]), b[0], b[3], b[4], p.x, p.y);
    printf("%d %d %d %s %d %d %d %d\n", s.id, s.pos.x, s.pos.y, s.name, s.tags[0], s.tags[1], s.tags[2], s.tags[3]);
    printf("%d %d %s %d %d %d %d %d\n", t.id, t.pos.y, t.name, t.tags[3], arr[0].x, arr[1].y, arr[2].x, arr[2].y);
    printf("%c%c%d%c %d\n", str[0], str[1], str[2], str[4], (int)sizeof str);
    return 0;
}
//// stdout
0 0 20 0 0 50 60 0 | 5 9 1 2 3 5
99 0 8 bob 0 0 7 0
1 3 al 7 0 11 0 12
ab0e 6
//// case: decl_partial_and_nested_initializers
#include <stdio.h>
struct In { int a[2]; char c; };
struct Out { struct In in[2]; double d; };
static struct Out g = {{{{1, 2}, 'x'}, {{3}}}, 2.5};
int main(void) {
    struct Out l = {{{{7, 8}, 'q'}}, 1.5};
    int m[2][3] = {{1}, {2, 3}};
    int z[5] = {0};
    char s1[10] = "hi";
    char s2[] = "hello";
    char s3[5] = "12345";
    printf("%d %d %c %d %d %.1f\n", g.in[0].a[1], g.in[1].a[0], g.in[0].c, g.in[1].a[1], (int)g.in[1].c, g.d);
    printf("%d %d %c %d %d %.1f\n", l.in[0].a[0], l.in[0].a[1], l.in[0].c, l.in[1].a[0], (int)l.in[1].c, l.d);
    printf("%d %d %d %d %d %d | %d %d\n", m[0][0], m[0][1], m[0][2], m[1][0], m[1][1], m[1][2], z[4], (int)sizeof(z));
    printf("%s %d %s %d %c%c%c%c%c\n", s1, (int)sizeof(s1), s2, (int)sizeof(s2), s3[0], s3[1], s3[2], s3[3], s3[4]);
    return 0;
}
