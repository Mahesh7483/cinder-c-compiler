//// case: decl_func_name_and_misc_builtins
#include <stdio.h>
#include <stdbool.h>
static const char *who(void) { return __func__; }
int main(void) {
    bool t = 5, f = 0;
    _Bool g = 0.5;
    printf("%s %s %d %d %d %d\n", who(), __func__, t, f, g, (int)sizeof(bool));
    printf("%d %d\n", __LINE__, (int)sizeof(__FILE__) > 1);
    printf("%d %d\n", __STDC_VERSION__ >= 201112L, __STDC__);
    return 0;
}
