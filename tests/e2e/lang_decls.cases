//// case: decl_compound_literals
#include <stdio.h>
struct P { int x, y; };
static int sum(const int *a, int n) { int s = 0; for (int i = 0; i < n; i++) s += a[i]; return s; }
static struct P mid(struct P a, struct P b) { return (struct P){(a.x + b.x) / 2, (a.y + b.y) / 2}; }
int main(void) {
    int total = 0;
    for (int i = 0; i < 3; i++) total += sum((int[]){i, i * 2, i * 3}, 3);
    struct P *p = &(struct P){4, 5};
    p->x += 10;
    struct P m = mid((struct P){0, 0}, (struct P){10, 20});
    const char *s = (const char[]){'o', 'k', 0};
    int v = (int){42} + 1;
    printf("%d %d %d %d %d %s %d\n", total, p->x, p->y, m.x, m.y, s, v);
    return 0;
}
//// stdout
18 14 5 5 10 ok 43
//// case: decl_string_and_char_literals
#include <stdio.h>
#include <string.h>
int main(void) {
    const char *a = "tab\there";
    const char *b = "quote\"back\\slash";
    const char *c = "hex\x41\x42" "C" "oct\101\102";
    const char *d = "con" "cat" "enated";
    printf("%s|%s|%s|%s\n", a, b, c, d);
    printf("%d %d %d %d %d %d\n", 'a', '\n', '\0', '\\', '\'', '\x7f');
    printf("%d %d %d\n", (int)sizeof("abc"), (int)strlen("abc\0def"), (int)sizeof("abc\0def"));
    printf("%d %d\n", (int)sizeof('a'), '\377' < 0);
    printf("%d %d %d\n", 0x7fffffff, 017, 0b101);
