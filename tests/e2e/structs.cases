//// case: bitfields
#include <stdio.h>
struct flags { unsigned a : 3; unsigned b : 5; unsigned c : 1; int d : 4; unsigned e : 12; };
int main(void) {
    struct flags f = {0};
    f.a = 5; f.b = 17; f.c = 1; f.d = -3; f.e = 4000;
    printf("%u %u %u %d %u\n", f.a, f.b, f.c, f.d, f.e);
    f.a += 4;
    f.b++;
    f.d--;
    printf("%u %u %d\n", f.a, f.b, f.d);
    f.e = 5000;
    printf("%u %zu\n", f.e, sizeof f);
    struct flags g = {1, 2, 0, 3, 4};
    printf("%u %u %u %d %u\n", g.a, g.b, g.c, g.d, g.e);
    return 0;
}
//// stdout
5 17 1 -3 4000
1 18 -4
904 4
1 2 0 3 4
//// case: bitfield_layout_and_pointer
#include <stdio.h>
struct s { char c; unsigned x : 4; unsigned y : 4; int z; };
struct t { unsigned a : 20; unsigned b : 20; };
int main(void) {
    struct s v = {'q', 9, 6, -1};
    struct s *p = &v;
    p->x = 15; p->y = 1;
    printf("%c %u %u %d %zu\n", v.c, v.x, v.y, v.z, sizeof v);
    struct t w = {0xFFFFF, 0x12345};
    printf("%x %x %zu\n", w.a, w.b, sizeof w);
    return 0;
}
//// stdout
q 15 1 -1 8
