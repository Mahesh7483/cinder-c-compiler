//// case: typedef_struct_and_designated_init
#include <stdio.h>
typedef struct { int a, b, c; } triple;
typedef struct node { int v; struct node *next; } node;
int main(void) {
    triple t = {.c = 3, .a = 1};
    triple u = {.b = 7};
    printf("%d %d %d | %d %d %d\n", t.a, t.b, t.c, u.a, u.b, u.c);
    node n2 = {2, 0}, n1 = {1, &n2};
    printf("%d %d\n", n1.v, n1.next->v);
    int arr[6] = {[1] = 10, [4] = 40, 50};
    for (int i = 0; i < 6; i++) printf("%d ", arr[i]);
    printf("\n");
    return 0;
}
//// stdout
1 0 3 | 0 7 0
1 2
0 10 0 0 40 50 
//// case: struct_pointer_members_and_function_pointers
#include <stdio.h>
struct ops { int (*apply)(int, int); const char *name; };
static int add(int a, int b) { return a + b; }
static int mul(int a, int b) { return a * b; }
int main(void) {
    struct ops table[] = {{add, "add"}, {mul, "mul"}};
    for (int i = 0; i < 2; i++) printf("%s: %d\n", table[i].name, table[i].apply(6, 7));
    struct ops *p = &table[1];
    printf("%d\n", p->apply(2, 3));
    return 0;
}
//// stdout
add: 13
mul: 42
6
//// case: struct_return_through_pointer_chain
#include <stdio.h>
struct pair { int a; int b; };
struct wrap { struct pair p; long extra; };
static struct wrap make(int a, int b) { struct wrap w = {{a, b}, a + b}; return w; }
static struct pair get(struct wrap w) { return w.p; }
int main(void) {
    struct wrap w = make(3, 4);
    struct pair p = get(w);
    printf("%d %d %ld\n", p.a, p.b, w.extra);
    printf("%d\n", make(10, 20).p.b + get(make(1, 2)).a);
    return 0;
}
//// stdout
3 4 7
21
