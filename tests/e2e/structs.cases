//// case: struct_basic
#include <stdio.h>
struct point { int x, y; };
int main(void) {
    struct point p = {3, 4};
    struct point q;
    q.x = 10; q.y = 20;
    printf("%d %d %d %d\n", p.x, p.y, q.x, q.y);
    struct point *pp = &p;
    pp->x += 100;
    (*pp).y *= 2;
    printf("%d %d\n", p.x, p.y);
    printf("%zu\n", sizeof(struct point));
    return 0;
}
//// stdout
3 4 10 20
103 8
8
//// case: struct_assignment_and_copy
#include <stdio.h>
struct rec { int id; double score; char name[12]; };
int main(void) {
    struct rec a = {7, 9.5, "alice"};
    struct rec b = a;
    b.id = 8; b.name[0] = 'A';
    struct rec c;
    c = b;
    printf("%d %.1f %s | %d %.1f %s | %d %s\n", a.id, a.score, a.name, b.id, b.score, b.name, c.id, c.name);
    return 0;
}
//// stdout
7 9.5 alice | 8 9.5 Alice | 8 Alice
//// case: struct_pass_by_value_small
#include <stdio.h>
struct p2 { int x, y; };
static int sum(struct p2 p) { return p.x + p.y; }
static struct p2 mk(int a, int b) { struct p2 r = {a, b}; return r; }
static struct p2 swap(struct p2 p) { struct p2 r = {p.y, p.x}; return r; }
int main(void) {
    struct p2 a = mk(3, 4);
    printf("%d\n", sum(a));
    struct p2 b = swap(a);
    printf("%d %d\n", b.x, b.y);
    printf("%d\n", sum(swap(mk(10, 1))));
    a.x = 99;
    printf("%d %d\n", sum(b), a.x);
    return 0;
}
//// stdout
7
4 3
11
7 99
//// case: struct_pass_by_value_16_bytes
#include <stdio.h>
struct two { long a, b; };
static long total(struct two t) { return t.a * 10 + t.b; }
static struct two make(long a, long b) { struct two t = {a, b}; return t; }
int main(void) {
    struct two t = make(5, 7);
    printf("%ld %ld %ld\n", t.a, t.b, total(t));
    struct two u = make(t.b, t.a);
    printf("%ld\n", total(u));
    return 0;
}
//// stdout
5 7 57
75
//// case: struct_pass_large_by_value
#include <stdio.h>
struct big { long a, b, c, d; };
static long sum(struct big v) { return v.a + v.b + v.c + v.d; }
static struct big make(long s) { struct big v = {s, s + 1, s + 2, s + 3}; return v; }
static struct big add(struct big x, struct big y) {
    struct big r = {x.a + y.a, x.b + y.b, x.c + y.c, x.d + y.d};
    return r;
}
int main(void) {
    struct big a = make(10), b = make(100);
    printf("%ld %ld\n", sum(a), sum(b));
    struct big c = add(a, b);
    printf("%ld %ld %ld %ld\n", c.a, c.b, c.c, c.d);
    a.a = 0;
    printf("%ld %ld\n", sum(a), sum(make(1)));
    return 0;
}
//// stdout
46 406
110 112 114 116
36 10
//// case: struct_with_doubles_in_registers
#include <stdio.h>
struct vec { double x, y; };
static struct vec add(struct vec a, struct vec b) { struct vec r = {a.x + b.x, a.y + b.y}; return r; }
static double dot(struct vec a, struct vec b) { return a.x * b.x + a.y * b.y; }
static struct vec scale(struct vec v, double k) { struct vec r = {v.x * k, v.y * k}; return r; }
int main(void) {
    struct vec a = {1.5, 2.5}, b = {4.0, -1.0};
    struct vec c = add(a, b);
    printf("%.2f %.2f %.2f\n", c.x, c.y, dot(a, b));
    struct vec d = scale(c, 2.0);
    printf("%.2f %.2f\n", d.x, d.y);
    return 0;
}
//// stdout
5.50 1.50 3.50
11.00 3.00
//// case: struct_mixed_int_and_float
#include <stdio.h>
struct mix { double d; long l; };
struct mix2 { long l; double d; };
struct fl { float a, b; };
static double f1(struct mix m) { return m.d + m.l; }
static double f2(struct mix2 m) { return m.d * m.l; }
static struct mix g1(void) { struct mix m = {1.25, 8}; return m; }
static struct fl h(struct fl v) { struct fl r = {v.b, v.a}; return r; }
int main(void) {
    struct mix m = {2.5, 4};
    struct mix2 m2 = {3, 0.5};
    printf("%.2f %.2f\n", f1(m), f2(m2));
    struct mix r = g1();
    printf("%.2f %ld\n", r.d, r.l);
    struct fl v = {1.0f, 2.0f};
    struct fl w = h(v);
    printf("%.1f %.1f\n", w.a, w.b);
    return 0;
}
//// stdout
6.50 1.50
1.25 8
2.0 1.0
//// case: struct_odd_sizes
#include <stdio.h>
struct s3 { char a, b, c; };
struct s5 { char a[5]; };
struct s12 { int a, b, c; };
static int sum3(struct s3 s) { return s.a + s.b + s.c; }
static int sum5(struct s5 s) { int t = 0; for (int i = 0; i < 5; i++) t += s.a[i]; return t; }
static int sum12(struct s12 s) { return s.a * 100 + s.b * 10 + s.c; }
static struct s3 mk3(void) { struct s3 s = {1, 2, 3}; return s; }
static struct s12 mk12(void) { struct s12 s = {4, 5, 6}; return s; }
int main(void) {
    struct s3 a = {10, 20, 30};
    struct s5 b = {{1, 2, 3, 4, 5}};
    struct s12 c = {1, 2, 3};
    printf("%d %d %d\n", sum3(a), sum5(b), sum12(c));
    printf("%d %d\n", sum3(mk3()), sum12(mk12()));
    return 0;
}
//// stdout
60 15 123
6 456
//// case: many_struct_arguments
#include <stdio.h>
struct p { long a, b; };
static long f(struct p a, struct p b, struct p c, struct p d) { return a.a + a.b + b.a + b.b + c.a + c.b + d.a + d.b; }
static long g(long x1, long x2, long x3, long x4, long x5, struct p s, long y) { return x1 + x2 + x3 + x4 + x5 + s.a * 100 + s.b * 1000 + y; }
int main(void) {
    struct p a = {1, 2}, b = {3, 4}, c = {5, 6}, d = {7, 8};
    printf("%ld\n", f(a, b, c, d));
    printf("%ld\n", g(1, 2, 3, 4, 5, a, 6));
    return 0;
}
//// stdout
36
2121
//// case: nested_structs_and_arrays
#include <stdio.h>
struct inner { int v[3]; char tag; };
struct outer { struct inner in[2]; int count; struct inner single; };
int main(void) {
    struct outer o = {{{{1, 2, 3}, 'a'}, {{4, 5, 6}, 'b'}}, 2, {{7, 8, 9}, 'c'}};
    int sum = 0;
    for (int i = 0; i < o.count; i++) for (int j = 0; j < 3; j++) sum += o.in[i].v[j];
    printf("%d %c %c %d\n", sum, o.in[1].tag, o.single.tag, o.single.v[2]);
    o.in[0].v[1] = 50;
    struct inner copy = o.in[0];
    copy.v[0] = 9;
    printf("%d %d %zu\n", o.in[0].v[1], copy.v[0], sizeof(struct outer));
    return 0;
}
//// stdout
21 b c 9
50 9 52
//// case: array_of_structs
#include <stdio.h>
struct item { const char *name; int qty; double price; };
int main(void) {
    struct item inv[] = {{"pen", 10, 1.5}, {"book", 3, 12.25}, {"bag", 1, 30.0}};
    double total = 0;
    for (int i = 0; i < 3; i++) {
        printf("%s x%d @ %.2f\n", inv[i].name, inv[i].qty, inv[i].price);
        total += inv[i].qty * inv[i].price;
    }
    printf("%.2f %zu\n", total, sizeof inv / sizeof inv[0]);
    struct item *p = inv + 1;
    printf("%s %s\n", p->name, (p + 1)->name);
    return 0;
}
//// stdout
pen x10 @ 1.50
book x3 @ 12.25
bag x1 @ 30.00
81.75 3
book bag
//// case: linked_list
#include <stdio.h>
#include <stdlib.h>
struct node { int v; struct node *next; };
static struct node *push(struct node *h, int v) { struct node *n = malloc(sizeof *n); n->v = v; n->next = h; return n; }
static struct node *reverse(struct node *h) {
    struct node *prev = NULL;
    while (h) { struct node *nx = h->next; h->next = prev; prev = h; h = nx; }
    return prev;
}
int main(void) {
    struct node *l = NULL;
    for (int i = 1; i <= 6; i++) l = push(l, i * i);
    for (struct node *p = l; p; p = p->next) printf("%d ", p->v);
    printf("\n");
    l = reverse(l);
    for (struct node *p = l; p; p = p->next) printf("%d ", p->v);
    printf("\n");
    while (l) { struct node *n = l->next; free(l); l = n; }
    return 0;
}
//// stdout
36 25 16 9 4 1 
1 4 9 16 25 36 
