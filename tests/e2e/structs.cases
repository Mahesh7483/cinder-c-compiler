//// case: pragma_pack_and_alignment
#include <stdio.h>
#include <stddef.h>
#pragma pack(push, 1)
struct packed { char c; int i; short s; };
#pragma pack(pop)
struct normal { char c; int i; short s; };
struct aligned { _Alignas(16) char c; };
int main(void) {
    printf("%zu %zu\n", sizeof(struct packed), sizeof(struct normal));
    printf("%zu %zu\n", offsetof(struct packed, i), offsetof(struct normal, i));
    printf("%zu %zu\n", sizeof(struct aligned), _Alignof(struct aligned));
    struct packed p = {'x', 123456, 7};
    printf("%c %d %d\n", p.c, p.i, p.s);
    return 0;
}
//// stdout
7 12
1 4
16 16
x 123456 7
//// case: compound_literals
#include <stdio.h>
struct pt { int x, y; };
static int sum(struct pt p) { return p.x + p.y; }
static int sum_arr(const int *a, int n) { int t = 0; for (int i = 0; i < n; i++) t += a[i]; return t; }
int main(void) {
    printf("%d\n", sum((struct pt){3, 4}));
    printf("%d\n", sum_arr((int[]){1, 2, 3, 4, 5}, 5));
    struct pt *p = &(struct pt){7, 8};
    p->x++;
    printf("%d %d\n", p->x, p->y);
    return 0;
}
//// stdout
7
15
8 8
//// case: struct_in_global_data
#include <stdio.h>
struct entry { const char *key; int value; };
static const struct entry table[] = {{"one", 1}, {"two", 2}, {"three", 3}};
struct entry gtable[2] = {{"a", 10}, {"b", 20}};
static int lookup(const char *k) {
    for (unsigned i = 0; i < sizeof table / sizeof table[0]; i++) {
        const char *a = table[i].key, *b = k;
        while (*a && *a == *b) { a++; b++; }
        if (*a == *b) return table[i].value;
    }
    return -1;
}
int main(void) {
    printf("%d %d %d %d\n", lookup("one"), lookup("three"), lookup("four"), gtable[1].value);
    gtable[0].value += 5;
    printf("%d %s\n", gtable[0].value, gtable[1].key);
    return 0;
}
//// stdout
1 3 -1 20
15 b
