//// case: libc_sprintf_snprintf_and_return_values
#include <stdio.h>
#include <string.h>
int main(void) {
    char buf[32];
    int n = sprintf(buf, "%d-%s-%.2f", 7, "x", 1.5);
    printf("%d [%s]\n", n, buf);
    n = snprintf(buf, sizeof buf, "%s", "a rather long string that does not fit in the buffer at all");
    printf("%d [%s] %d\n", n, buf, (int)strlen(buf));
    n = snprintf(buf, 6, "%d", 123456789);
    printf("%d [%s]\n", n, buf);
    n = snprintf(NULL, 0, "%05d|%-5s|", 42, "ab");
    printf("%d\n", n);
    n = printf("hello\n");
    printf("%d\n", n);
    puts("puts adds newline");
    putchar('c'); putchar('\n');
    fputs("fputs no newline", stdout);
    fputc('\n', stdout);
    return 0;
}
