#include <stdio.h>
int main(void) {
    int a, b;
    double d;
    char word[32], c;
    int n = sscanf("12 34 5.5 hello x", "%d %d %lf %31s %c", &a, &b, &d, word, &c);
    printf("%d: %d %d %.1f %s %c\n", n, a, b, d, word, c);
    int hex, oct;
    n = sscanf("ff 17 -5", "%x %o %d", &hex, &oct, &a);
    printf("%d: %d %d %d\n", n, hex, oct, a);
    int pos;
    n = sscanf("abc 123", "abc %d%n", &a, &pos);
    printf("%d: %d %d\n", n, a, pos);
    char first[8], second[8];
    n = sscanf("one,two", "%7[^,],%7s", first, second);
    printf("%d: %s %s\n", n, first, second);
    n = sscanf("nothing", "%d", &a);
    printf("%d\n", n);
    long l; unsigned u;
    n = sscanf("-9000000000 4000000000", "%ld %u", &l, &u);
    printf("%d: %ld %u\n", n, l, u);
    return 0;
}
