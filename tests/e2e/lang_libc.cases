//// case: libc_ctype
#include <stdio.h>
#include <ctype.h>
int main(void) {
    const char *s = "Hello, World! 123 \t\n_";
    int alpha = 0, digit = 0, space = 0, punct = 0, upper = 0, lower = 0, alnum = 0, xd = 0, pr = 0;
    for (const char *p = s; *p; p++) {
        unsigned char c = *p;
        alpha += !!isalpha(c); digit += !!isdigit(c); space += !!isspace(c); punct += !!ispunct(c);
        upper += !!isupper(c); lower += !!islower(c); alnum += !!isalnum(c); xd += !!isxdigit(c); pr += !!isprint(c);
    }
    printf("%d %d %d %d %d %d %d %d %d\n", alpha, digit, space, punct, upper, lower, alnum, xd, pr);
    char buf[16] = "MiXeD cAsE 42";
    for (char *p = buf; *p; p++) *p = (char)toupper((unsigned char)*p);
    printf("%s ", buf);
    for (char *p = buf; *p; p++) *p = (char)tolower((unsigned char)*p);
    printf("%s\n", buf);
    return 0;
}
