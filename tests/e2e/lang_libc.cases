//// case: libc_variadic_wrappers_vprintf
#include <stdio.h>
#include <stdarg.h>
static int log_msg(const char *level, const char *fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    printf("[%s] ", level);
    int n = vprintf(fmt, ap);
    va_end(ap);
    printf("\n");
    return n;
}
static void to_buf(char *buf, size_t n, const char *fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(buf, n, fmt, ap);
    va_end(ap);
}
int main(void) {
    int n = log_msg("info", "value=%d name=%s pi=%.2f", 42, "x", 3.14159);
    log_msg("warn", "no args");
    char b[40];
    to_buf(b, sizeof b, "%s-%d-%c", "abc", 9, 'q');
    printf("%d %s\n", n, b);
    return 0;
}
