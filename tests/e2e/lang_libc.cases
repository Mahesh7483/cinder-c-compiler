//// case: libc_stdin_lines_and_words
#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main(void) {
    char line[128];
    int lines = 0, words = 0, chars = 0;
    while (fgets(line, sizeof line, stdin)) {
        lines++;
        chars += (int)strlen(line);
        int in_word = 0;
        for (char *p = line; *p; p++) {
            if (isspace((unsigned char)*p)) in_word = 0;
            else if (!in_word) { in_word = 1; words++; }
        }
    }
    printf("%d %d %d\n", lines, words, chars);
    return 0;
}
