//// case: libc_qsort_and_bsearch
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
struct P { char name[8]; int age; };
static int cmp_int(const void *a, const void *b) { int x = *(const int *)a, y = *(const int *)b; return (x > y) - (x < y); }
static int cmp_desc(const void *a, const void *b) { return cmp_int(b, a); }
static int cmp_str(const void *a, const void *b) { return strcmp(*(const char *const *)a, *(const char *const *)b); }
static int cmp_age(const void *a, const void *b) { return ((const struct P *)a)->age - ((const struct P *)b)->age; }
int main(void) {
    int a[] = {42, 7, 19, -3, 100, 0, 7, 55};
    qsort(a, 8, sizeof a[0], cmp_int);
    for (int i = 0; i < 8; i++) printf("%d ", a[i]);
    printf("\n");
    qsort(a, 8, sizeof a[0], cmp_desc);
    for (int i = 0; i < 8; i++) printf("%d ", a[i]);
    printf("\n");
    const char *words[] = {"pear", "apple", "fig", "banana", "cherry"};
    qsort(words, 5, sizeof words[0], cmp_str);
    for (int i = 0; i < 5; i++) printf("%s ", words[i]);
    printf("\n");
    struct P people[] = {{"ann", 31}, {"bob", 25}, {"cy", 40}, {"di", 19}};
    qsort(people, 4, sizeof people[0], cmp_age);
    for (int i = 0; i < 4; i++) printf("%s:%d ", people[i].name, people[i].age);
    printf("\n");
    qsort(a, 8, sizeof a[0], cmp_int);
    int key = 55;
    int *hit = bsearch(&key, a, 8, sizeof a[0], cmp_int);
    int miss = 56;
    printf("%d %d\n", hit ? (int)(hit - a) : -1, bsearch(&miss, a, 8, sizeof a[0], cmp_int) == NULL);
    return 0;
}
