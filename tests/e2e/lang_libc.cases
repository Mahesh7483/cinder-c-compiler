//// case: libc_linked_list_and_tree
#include <stdio.h>
#include <stdlib.h>
struct node { int v; struct node *next; };
struct tree { int key; struct tree *l, *r; };
static struct node *push(struct node *h, int v) { struct node *n = malloc(sizeof *n); n->v = v; n->next = h; return n; }
static struct node *reverse(struct node *h) {
    struct node *prev = NULL;
    while (h) { struct node *nx = h->next; h->next = prev; prev = h; h = nx; }
    return prev;
}
static struct tree *insert(struct tree *t, int k) {
    if (!t) { t = calloc(1, sizeof *t); t->key = k; return t; }
    if (k < t->key) t->l = insert(t->l, k); else t->r = insert(t->r, k);
    return t;
}
static void inorder(const struct tree *t) { if (!t) return; inorder(t->l); printf("%d ", t->key); inorder(t->r); }
static int height(const struct tree *t) { if (!t) return 0; int a = height(t->l), b = height(t->r); return 1 + (a > b ? a : b); }
static void destroy(struct tree *t) { if (!t) return; destroy(t->l); destroy(t->r); free(t); }
int main(void) {
    struct node *h = NULL;
    for (int i = 1; i <= 6; i++) h = push(h, i * i);
    for (struct node *p = h; p; p = p->next) printf("%d ", p->v);
    printf("| ");
    h = reverse(h);
    for (struct node *p = h; p; ) { printf("%d ", p->v); struct node *nx = p->next; free(p); p = nx; }
    printf("\n");
    struct tree *t = NULL;
    int keys[] = {50, 30, 70, 20, 40, 60, 80, 35, 45, 65};
    for (int i = 0; i < 10; i++) t = insert(t, keys[i]);
    inorder(t);
    printf("| h=%d\n", height(t));
    destroy(t);
    return 0;
}
