//// case: libc_file_io_tmpfile
#include <stdio.h>
#include <string.h>
int main(void) {
    FILE *f = tmpfile();
    for (int i = 0; i < 5; i++) fprintf(f, "line %d: %s\n", i, i % 2 ? "odd" : "even");
    rewind(f);
    char buf[64];
    while (fgets(buf, sizeof buf, f)) fputs(buf, stdout);
    long pos = ftell(f);
    fseek(f, 7, SEEK_SET);
    int c = fgetc(f);
    ungetc(c, f);
    printf("%ld %c %c\n", pos, c, fgetc(f));
    fseek(f, 0, SEEK_END);
    printf("%ld\n", ftell(f));
    rewind(f);
    unsigned char bytes[10];
    size_t n = fread(bytes, 1, sizeof bytes, f);
    printf("%d %d %d\n", (int)n, bytes[0], bytes[5]);
    fclose(f);
    f = tmpfile();
    int vals[4] = {10, 20, 30, 40};
    fwrite(vals, sizeof vals[0], 4, f);
    rewind(f);
    int back[4];
    int got = (int)fread(back, sizeof back[0], 4, f);
    int at_eof = feof(f);
    printf("%d %d %d\n", got, back[2], at_eof);
    fclose(f);
    return 0;
}
