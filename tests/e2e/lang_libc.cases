//// case: libc_printf_conversions_and_flags
#include <stdio.h>
int main(void) {
    printf("[%d] [%i] [%u] [%o] [%x] [%X] [%c] [%s] [%%]\n", -42, 42, 4000000000u, 64, 255, 255, 'z', "str");
    printf("[%5d] [%-5d] [%05d] [%+d] [% d] [%+d]\n", 42, 42, 42, 42, 42, -42);
    printf("[%#x] [%#o] [%#X] [%08.3f] [%-8.2f|] [%+.1f]\n", 255, 8, 255, 3.14159, 2.71828, 1.05);
    printf("[%10s] [%-10s] [%.3s] [%10.3s]\n", "right", "left", "truncate", "truncate");
    printf("[%*d] [%-*d] [%.*f] [%*.*f]\n", 6, 42, 6, 42, 2, 3.14159, 9, 3, 2.71828);
    printf("[%ld] [%lld] [%lu] [%llu] [%zu] [%hd] [%hhd] [%hu]\n", -1L, -1LL, 18446744073709551615UL, 18446744073709551615ULL, (size_t)7, (short)-5, (signed char)-3, (unsigned short)65535);
    printf("[%e] [%E] [%g] [%G] [%g] [%g]\n", 12345.678, 0.000123, 0.0001, 1e20, 100000.0, 1234567.0);
    printf("[%f] [%.0f] [%.10f] [%5.1f]\n", 1.0 / 3, 2.5, 1.0 / 3, 99.95);
    printf("[%c%c%c] [%5c] [%-5c|]\n", 'a', 'b', 'c', 'x', 'y');
    printf("%s %s\n", "multiple", "args");
    int n;
    printf("abc%n\n", &n);
    printf("%d\n", n);
    return 0;
}
