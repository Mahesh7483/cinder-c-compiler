//// case: vla_typedef_and_pointer_to_vla
#include <stdio.h>
static int f(int n) {
    typedef int row_t[n];
    row_t x, y;
    for (int i = 0; i < n; i++) { x[i] = i; y[i] = 10 * i; }
    row_t *p = &x;
    int (*q)[n] = &y;
    printf("%d %d %d %d\n", (*p)[n - 1], (*q)[n - 1], (int)sizeof(row_t), (int)sizeof(*p));
    int a[3][n];
    int (*r)[n] = a;
    for (int i = 0; i < 3; i++) for (int j = 0; j < n; j++) a[i][j] = i + j;
    r++;
    printf("%d %d %d\n", (*r)[0], r[1][n - 1], (int)(r - a));
    r += 1;
    printf("%d\n", r[0][n - 1]);
    return n;
}
int main(void) { return f(5) + f(1) - 6; }
