//// case: vla_in_loops_does_not_leak_stack
#include <stdio.h>
int main(void) {
    long total = 0;
    for (int i = 0; i < 1000000; i++) {
        int n = 1024 + (i % 4);
        char buf[n];
        buf[0] = (char)i;
        buf[n - 1] = (char)(i >> 3);
        if (i % 7 == 0) continue;
        total += buf[0] + buf[n - 1];
        if (i == 999990) break;
    }
    printf("%ld\n", total);
    int j = 0;
    while (j < 500000) {
        int n = 2048;
        double d[n / 8];
        d[0] = j;
        d[n / 8 - 1] = d[0] * 2;
        j++;
        if (d[n / 8 - 1] < 0) break;
    }
    printf("%d\n", j);
    return 0;
}
