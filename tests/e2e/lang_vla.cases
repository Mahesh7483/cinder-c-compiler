//// case: vla_casts_and_sizeof_type_names
#include <stdio.h>
static int g(int n) {
    int buf[n * n];
    for (int i = 0; i < n * n; i++) buf[i] = i;
    int (*m)[n] = (int (*)[n])buf;
    printf("%d %d %d\n", m[1][1], m[n - 1][n - 1], (int)sizeof(int[n]));
    printf("%d %d\n", (int)sizeof(int[n][n]), (int)sizeof(char[n + 1]));
    return (int)sizeof(buf);
}
int main(void) { printf("%d\n", g(3)); printf("%d\n", g(6)); return 0; }
