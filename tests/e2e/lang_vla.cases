//// case: vla_basic_sum_fill_and_sizeof
#include <stdio.h>
static int run(int n) {
    int a[n];
    for (int i = 0; i < n; i++) a[i] = i * i;
    int s = 0;
    for (int i = 0; i < n; i++) s += a[i];
    printf("%d %d %d\n", s, (int)(sizeof(a) / sizeof(a[0])), (int)sizeof(a));
    return s;
}
int main(void) {
    run(1);
    run(10);
    run(100);
    return run(5) & 7;
}
