//// case: vla_three_dimensional
#include <stdio.h>
int main(void) {
    int a = 2, b = 3, c = 4;
    int t[a][b][c];
    for (int i = 0; i < a; i++)
        for (int j = 0; j < b; j++)
            for (int k = 0; k < c; k++) t[i][j][k] = i * 100 + j * 10 + k;
    printf("%d %d %d %d\n", t[0][0][0], t[1][2][3], t[1][0][2], t[0][2][1]);
    printf("%d %d %d\n", (int)sizeof(t), (int)sizeof(t[0]), (int)sizeof(t[0][0]));
    int (*p)[c] = t[1];
    printf("%d %d\n", p[2][3], (int)(&t[1][2] - &t[0][0]));
    return 0;
}
