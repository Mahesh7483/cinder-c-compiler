//// case: vla_with_calls_stack_args_and_varargs
#include <stdio.h>
#include <string.h>
struct P { long a, b, c; };
static long many(long a, long b, long c, long d, long e, long f, long g, long h, long i, long j) {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8 + i * 9 + j * 10;
}
static long byval(struct P p, struct P q) { return p.a + p.b * 2 + p.c * 3 + q.a * 4 + q.b * 5 + q.c * 6; }
static double mixed(double a, int n, double b) { return a * n + b; }
int main(void) {
    int n = 20;
    long v[n];
    for (int i = 0; i < n; i++) v[i] = i + 1;
    struct P p = {v[0], v[1], v[2]}, q = {v[3], v[4], v[5]};
    printf("%ld %ld\n", many(v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9]), byval(p, q));
    printf("%.2f %d %s %c\n", mixed(1.5, (int)v[3], 2.25), (int)v[19], "str", (char)('a' + v[2]));
    {
        int m = 7;
        char text[m + 1];
        memset(text, 'x', m);
        text[m] = 0;
        printf("%s %d\n", text, (int)strlen(text));
        long w[m];
        for (int i = 0; i < m; i++) w[i] = many(i, i, i, i, i, i, i, i, i, i);
        printf("%ld %ld\n", w[0], w[m - 1]);
    }
    printf("%ld\n", v[n - 1]);
    return 0;
}
