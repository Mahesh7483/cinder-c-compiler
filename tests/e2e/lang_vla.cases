//// case: vla_two_dimensional_runtime_strides
#include <stdio.h>
static long fill_and_sum(int r, int c) {
    int m[r][c];
    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++) m[i][j] = i * 100 + j;
    long s = 0;
    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++) s += m[i][j] * (i + 1);
    printf("%d %d %d\n", (int)sizeof(m), (int)sizeof(m[0]), (int)sizeof(m[0][0]));
    printf("%d %d\n", m[r - 1][c - 1], *(*(m + 1) + 1));
    int *flat = &m[0][0];
    printf("%d %d\n", flat[c], flat[c + 2]);
    return s;
}
int main(void) {
    printf("%ld\n", fill_and_sum(3, 4));
    printf("%ld\n", fill_and_sum(5, 2));
    printf("%ld\n", fill_and_sum(2, 7));
    return 0;
}
