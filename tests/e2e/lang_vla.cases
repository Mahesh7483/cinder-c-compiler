//// case: vla_recursion_and_alignment
#include <stdio.h>
static int bad;
static long walk(int depth, int n) {
    double d[n];
    long l[n / 2 + 1];
    d[0] = depth; l[0] = depth * 3;
    if (((unsigned long)d) % 16) bad |= 1;
    if (((unsigned long)l) % 16) bad |= 2;
    if (depth == 0) return d[0] + l[0];
    return walk(depth - 1, n + 1) + (long)d[0] + l[0];
}
struct S { char c; double d; };
int main(void) {
    long r = walk(50, 3);
    for (int n = 1; n < 9; n++) {
        struct S s[n];
        char tail[n];
        s[0].d = n; tail[0] = 1;
        if (((unsigned long)s) % 16) bad |= 4;
    }
    printf("%ld %d\n", r, bad);
    return 0;
}
