//// case: vla_in_switch_and_nested_blocks
#include <stdio.h>
static int pick(int k, int n) {
    int total = 0;
    switch (k) {
    case 0: {
        int a[n];
        for (int i = 0; i < n; i++) a[i] = i;
        for (int i = 0; i < n; i++) total += a[i];
        break;
    }
    case 1: {
        int b[n * 2];
        for (int i = 0; i < n * 2; i++) b[i] = i * 2;
        total = b[n * 2 - 1];
        { int c[n]; c[0] = 5; total += c[0]; }
        break;
    }
    default:
        total = -1;
    }
    return total;
}
int main(void) {
    for (int k = 0; k < 3; k++) printf("%d %d\n", pick(k, 5), pick(k, 9));
    return 0;
}
