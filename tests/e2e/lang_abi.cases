long f_ints(long a, int b, short c, char d, unsigned char e, unsigned short f, unsigned g, long h, long i, long j) {
    return a * 1 + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + (long)g * 7 + h * 8 + i * 9 + j * 10;
